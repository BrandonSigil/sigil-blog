---
// /artists: every artist picked or reviewed, A–Z. Artists with two or more entries get their own
// page; the rest link straight to the album in its post.
import HubPage from '../../layouts/HubPage.astro';
import { getAlbumPicks } from '../../lib/albums';
import { groupByArtist, letterOf } from '../../lib/hubs';
import { getPosts } from '../../lib/posts';

const reviews = (await getPosts()).filter((p) => p.data.projectName === 'Album Review');
const artists = groupByArtist(await getAlbumPicks(), reviews);
const letters = [...new Set(artists.map(letterOf))];
---

<HubPage
	title="Artists A–Z"
	kicker='<a href="/albums">Album index</a>'
	description={`All ${artists.length} artists picked or reviewed on Sigil, A to Z.`}
	count={`${artists.length} artists`}
	current="/artists"
>
	<nav class="letters" aria-label="Jump to letter" data-glide-group>
		{letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
	</nav>

	{letters.map((l) => (
		<section class="letter" id={`letter-${l}`}>
			<h2>{l}</h2>
			<ul>
				{artists.filter((a) => letterOf(a) === l).map((a) => (
					<li>
						{a.href ? <a class="name" href={a.href}>{a.name}</a> : <span class="name">{a.name}</span>}
						<span class="works">
							{a.picks.map((p) => <a href={p.href}>{p.album}</a>)}
							{a.reviews.map((r) => <a href={`/blog/${r.id}`}>{r.data.title} (review)</a>)}
						</span>
					</li>
				))}
			</ul>
		</section>
	))}
</HubPage>

<style>
	.letters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 2rem;
	}

	.letters a {
		min-width: 2rem;
		padding: 0.25rem 0.45rem;
		text-align: center;
		border: 1px solid var(--rule-strong);
		border-radius: 5px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		color: var(--ink);
		text-decoration: none;
		transition:
			transform var(--dur-press) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.letters a:hover {
			border-color: var(--green);
			color: var(--green-dark);
		}
	}

	.letters a:active {
		transform: scale(0.95);
	}

	.letter {
		display: grid;
		grid-template-columns: 3.25rem 1fr;
		gap: 1rem;
		padding: 1.15rem 0;
		border-top: 1px solid var(--rule);
		scroll-margin-top: 5.5rem;
	}

	.letter h2 {
		margin: 0;
		font-size: 1.65rem;
		color: var(--green);
	}

	.letter ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.letter li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.85rem;
	}

	.name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	a.name {
		color: var(--green);
	}

	.works {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.85rem;
		font-size: 14.5px;
	}

	.works a {
		color: var(--ink-soft);
	}

	@media (hover: hover) and (pointer: fine) {
		.works a:hover {
			color: var(--green);
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}
</style>
