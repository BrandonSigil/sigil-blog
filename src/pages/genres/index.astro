---
// /genres: every genre with a few of its covers.
import { Image } from 'astro:assets';
import HubPage from '../../layouts/HubPage.astro';
import { getAlbumPicks } from '../../lib/albums';
import { groupByGenre } from '../../lib/hubs';

const genres = groupByGenre(await getAlbumPicks());
---

<HubPage
	title="Genres"
	kicker='<a href="/albums">Album index</a>'
	description="Every album picked on New Music Friday, grouped by genre."
	current="/genres"
>
	<ul class="genre-list">
		{genres.map((g) => (
			<li>
				<a class="genre" href={g.href}>
					<div class="genre-covers">
						{g.picks.slice(0, 4).map((p) =>
							p.cover ? <Image src={p.cover} alt="" width={160} height={160} /> : <span class="blank" />,
						)}
					</div>
					<span class="genre-name">{g.name}</span>
					<span class="hub-muted">{g.picks.length} album{g.picks.length === 1 ? '' : 's'}</span>
				</a>
			</li>
		))}
	</ul>
</HubPage>

<style>
	.genre-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 2rem 1.5rem;
	}
	.genre {
		display: flex;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}
	.genre-covers {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
		padding: 4px;
		margin-bottom: 0.7rem;
		border: 2px solid var(--green);
		border-radius: 8px;
		background: var(--gray-lighter);
		transition: translate 0.2s ease, box-shadow 0.2s ease;
	}
	.genre:hover .genre-covers {
		translate: -3px -3px;
		box-shadow: 6px 6px 0 var(--green);
	}
	.genre-covers :global(img),
	.genre-covers .blank {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 4px;
	}
	.genre-name {
		font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--green);
	}
</style>
