---
// /genres: every genre with a few of its covers.
import { Image } from 'astro:assets';
import HubPage from '../../layouts/HubPage.astro';
import { getAlbumPicks } from '../../lib/albums';
import { groupByGenre } from '../../lib/hubs';

const genres = groupByGenre(await getAlbumPicks());
---

<HubPage
	title="Genres"
	kicker='<a href="/albums">Album index</a>'
	description="Every album picked on New Music Friday, grouped by genre."
	current="/genres"
>
	<ul class="genre-list">
		{genres.map((g) => (
			<li>
				<a class="genre" href={g.href}>
					<div class="genre-covers">
						{g.picks.slice(0, 4).map((p) =>
							p.cover ? <Image src={p.cover} alt="" width={160} height={160} /> : <span class="blank" />,
						)}
					</div>
					<span class="genre-name">{g.name}</span>
					<span class="hub-muted">{g.picks.length} album{g.picks.length === 1 ? '' : 's'}</span>
				</a>
			</li>
		))}
	</ul>
</HubPage>

<style>
	.genre-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 2rem 1.5rem;
	}

	.genre {
		display: flex;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
		transition: transform var(--dur-press) var(--ease-out);
	}

	.genre:active {
		transform: scale(0.985);
	}

	.genre-covers {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3px;
		padding: 4px;
		margin-bottom: 0.7rem;
		border-radius: 7px;
		background: var(--paper-card);
		box-shadow: var(--shadow-card);
		transition:
			transform var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.genre:hover .genre-covers,
		.genre:focus-visible .genre-covers {
			transform: translateY(-2px);
			box-shadow: var(--shadow-card-hover);
			transition-duration: var(--dur-fast);
		}
	}

	.genre-covers :global(img),
	.genre-covers .blank {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 4px;
	}

	.genre-name {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--green);
	}
</style>
