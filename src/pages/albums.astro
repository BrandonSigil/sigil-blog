---
// Every album recommended in a New Music Friday post, pulled from the posts themselves.
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { getAlbumPicks } from '../lib/albums';
import HubNav from '../components/HubNav.astro';

const picks = await getAlbumPicks();
const description = `All ${picks.length} albums we've recommended on New Music Friday, each linked to its write-up.`;
const year = (date: Date) => date.getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Album index | ${SITE_TITLE}`} description={description} />
		<style>
			.page-header {
				margin-bottom: 2rem;
				padding-bottom: 1.75rem;
				border-bottom: 1px solid var(--green);
			}

			.page-header h1 {
				margin: 0.35rem 0 0;
			}

			.tools {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem 1rem;
				margin-top: 1.35rem;
			}

			.tools input {
				flex: 1 1 16rem;
				max-width: 24rem;
				padding: 0.52rem 0.85rem;
				border: 1px solid var(--rule-strong);
				border-radius: 6px;
				background: var(--paper-card);
				color: var(--ink);
				font-family: var(--font-sans);
				font-size: 15px;
				box-shadow: var(--shadow-card);
				transition:
					border-color var(--dur-fast) var(--ease-out),
					box-shadow var(--dur-fast) var(--ease-out);
			}

			.tools input:focus-visible {
				outline: none;
				border-color: var(--green);
				box-shadow: 0 0 0 3px rgba(62, 125, 60, 0.16);
			}

			.sort {
				display: inline-flex;
				gap: 0.2rem;
				padding: 0.2rem;
				border: 1px solid var(--rule-strong);
				border-radius: 6px;
				background: var(--paper-card);
			}

			.sort button {
				padding: 0.34rem 0.75rem;
				border: none;
				border-radius: 4px;
				background: transparent;
				color: var(--ink-soft);
				font-family: var(--font-mono);
				font-size: 11.5px;
				font-weight: 500;
				cursor: pointer;
				transition:
					transform var(--dur-press) var(--ease-out),
					color var(--dur-fast) var(--ease-out),
					background-color var(--dur-fast) var(--ease-out);
			}

			.sort button:active {
				transform: scale(0.96);
			}

			.sort button[aria-pressed='true'] {
				background: var(--green);
				color: var(--white);
			}

			.count {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 12px;
				color: var(--gray);
				font-variant-numeric: tabular-nums;
			}

			.album-grid {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
				gap: 1.85rem 1.25rem;
			}

			.album-grid li[hidden] {
				display: none;
			}

			.album {
				display: flex;
				flex-direction: column;
				color: inherit;
				text-decoration: none;
				transition: transform var(--dur-press) var(--ease-out);
			}

			.album:active {
				transform: scale(0.985);
			}

			.album-sleeve {
				aspect-ratio: 1;
				margin-bottom: 0.7rem;
				border-radius: 7px;
				overflow: hidden;
				background: var(--gray-lighter);
				box-shadow: var(--shadow-card);
				transition:
					transform var(--dur-base) var(--ease-out),
					box-shadow var(--dur-base) var(--ease-out);
			}

			@media (hover: hover) and (pointer: fine) {
				.album:hover .album-sleeve,
				.album:focus-visible .album-sleeve {
					transform: translateY(-2px);
					box-shadow: var(--shadow-card-hover);
					transition-duration: var(--dur-fast);
				}

				.album:hover .album-sleeve :global(img) {
					transform: scale(1.03);
					transition-duration: var(--dur-fast);
				}
			}

			.album-sleeve :global(img) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform var(--dur-base) var(--ease-out);
			}

			.album-artist {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 1rem;
				line-height: 1.2;
				letter-spacing: -0.02em;
				color: var(--ink);
				transition: color var(--dur-fast) var(--ease-out);
			}

			@media (hover: hover) and (pointer: fine) {
				.album:hover .album-artist {
					color: var(--green);
				}
			}

			.album-title {
				font-size: 14px;
				line-height: 1.35;
				color: var(--ink-soft);
			}

			.album-year {
				margin-top: 0.3rem;
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--green);
				font-variant-numeric: tabular-nums;
			}

			.empty {
				color: var(--gray);
				font-family: var(--font-mono);
				font-size: 13px;
			}

			@media (max-width: 480px) {
				.album-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				<span class="kicker">Archive Index</span>
				<h1>Album index</h1>
				<div class="tools">
					<input type="search" placeholder="Artist or album" aria-label="Filter albums" data-album-filter />
					<div class="sort" role="group" aria-label="Sort albums">
						<button type="button" data-sort="date" aria-pressed="true">Newest</button>
						<button type="button" data-sort="artist" aria-pressed="false">Artist A–Z</button>
					</div>
					<p class="count" data-album-count aria-live="polite">{picks.length} albums</p>
				</div>
				<HubNav current="/albums" />
			</header>

			<ul class="album-grid" data-album-grid>
				{picks.map((pick, i) => (
					<li
						data-order={i}
						data-artist={pick.artist.replace(/^the\s+/i, '').toLowerCase()}
						data-text={`${pick.artist} ${pick.album}`.toLowerCase()}
					>
						<a class="album" href={pick.href}>
							<div class="album-sleeve">
								{pick.cover && (
									<Image
										src={pick.cover}
										alt={`${pick.album} by ${pick.artist}`}
										width={340}
										height={340}
										loading={i < 12 ? 'eager' : 'lazy'}
									/>
								)}
							</div>
							<span class="album-artist">{pick.artist}</span>
							<span class="album-title">{pick.album}</span>
							<span class="album-year">{year(pick.pubDate)}</span>
						</a>
					</li>
				))}
			</ul>
			<p class="empty" data-album-empty hidden>No matches.</p>
		</main>
		<Footer />

		<script>
			const grid = document.querySelector<HTMLElement>('[data-album-grid]');
			const filter = document.querySelector<HTMLInputElement>('[data-album-filter]');
			const count = document.querySelector<HTMLElement>('[data-album-count]');
			const empty = document.querySelector<HTMLElement>('[data-album-empty]');
			const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-sort]')];

			if (grid) {
				const items = [...grid.children] as HTMLElement[];

				filter?.addEventListener('input', () => {
					const words = filter.value.toLowerCase().split(/\s+/).filter(Boolean);
					let shown = 0;
					for (const item of items) {
						const match = words.every((w) => (item.dataset.text ?? '').includes(w));
						item.hidden = !match;
						if (match) shown++;
					}
					if (count) count.textContent = `${shown} ${shown === 1 ? 'album' : 'albums'}`;
					if (empty) empty.hidden = shown > 0;
				});

				buttons.forEach((button) => {
					button.addEventListener('click', () => {
						const byArtist = button.dataset.sort === 'artist';
						const sorted = [...items].sort((a, b) =>
							byArtist
								? (a.dataset.artist ?? '').localeCompare(b.dataset.artist ?? '')
								: Number(a.dataset.order) - Number(b.dataset.order),
						);
						grid.append(...sorted);
						buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
					});
				});
			}
		</script>
	</body>
</html>
