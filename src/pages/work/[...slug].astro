---
import { getCollection, type CollectionEntry } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';
import BrandCase from '../../components/work/templates/BrandCase.astro';
import ProductCase from '../../components/work/templates/ProductCase.astro';
import SiteCase from '../../components/work/templates/SiteCase.astro';

export async function getStaticPaths() {
	const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
	return cases.map((entry, i) => ({
		params: { slug: entry.id },
		props: { entry, next: cases[(i + 1) % cases.length], index: i + 1 },
	}));
}

interface Props {
	entry: CollectionEntry<'work'>;
	next: CollectionEntry<'work'>;
	index: number;
}

const { entry, next, index } = Astro.props;
const Template = { brand: BrandCase, product: ProductCase, site: SiteCase }[entry.data.template];
---

<CaseStudy entry={entry} next={next}>
	<Template entry={entry} index={index} />
</CaseStudy>
