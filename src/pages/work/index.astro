---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_STUDIO, SITE_TITLE } from '../../consts';
import heroImage from '../../assets/cases/helium/billboard-pink.jpg';
import '../../styles/work.css';

const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const previews = await Promise.all(
	cases.map((c) => getImage({ src: c.data.cover, width: 640, format: 'webp' })),
);

// Collapse disciplines into the filter buckets shown in the toolbar.
const bucket = (d: string) => (d === 'Art Direction' ? 'brand' : d.toLowerCase());
const filters = ['brand', 'product', 'web'] as const;
const label = { all: 'All', brand: 'Brand', product: 'Product', web: 'Web' } as const;
const counts = Object.fromEntries(
	filters.map((f) => [f, cases.filter((c) => c.data.disciplines.some((d) => bucket(d) === f)).length]),
);

// Grid rhythm: asymmetric pairs, then an even pair. Re-applied in JS after filtering.
const SPANS = [7, 5, 5, 7, 6, 6];

const archive = [
	{ name: 'Customer Fields', what: 'Marketing site for a Shopify forms app', for: 'Helium', year: '2018–23' },
	{ name: 'Meteor Mega Menus', what: 'Mega menu app for Shopify stores', for: 'Helium', year: '—' },
	{ name: 'Peter Rebik', what: 'Portfolio site, about 4 KB of JavaScript', for: 'Peter Rebik', year: '2026' },
	{ name: 'Lodestone', what: 'Tactics RPG prototype in Godot', for: 'Personal', year: '2026' },
];

const siteUrl = Astro.site?.href ?? 'https://sigil.studio';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `Work | ${SITE_TITLE}`,
	url: new URL('/work', siteUrl).href,
	hasPart: cases.map((c) => ({
		'@type': 'CreativeWork',
		name: c.data.title,
		url: new URL(`/work/${c.id}`, siteUrl).href,
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Work | ${SITE_TITLE}`}
			description={`Selected brand, product and web work from ${SITE_STUDIO}, a two-person studio in Tacoma, WA.`}
			image={heroImage}
			structuredData={structuredData}
		/>
	</head>
	<body>
		<Header />
		<main class="w">
			<header class="w-intro">
				<h1 class="w-title">
					Work<sup class="mono">({String(cases.length).padStart(2, '0')})</sup>
				</h1>
				<div class="w-intro-side">
					<p class="w-lede">
						Brand identities, products and websites for software companies, contractors and neighborhood
						shops, designed and built in Tacoma.
					</p>
					<p class="mono w-where">Tacoma, WA · 2018–2026</p>
				</div>
			</header>

			<div class="w-toolbar" role="toolbar" aria-label="Filter and view">
				<div class="w-filters" role="group" aria-label="Filter by discipline">
					<button type="button" class="w-chip" data-filter="all" aria-pressed="true">
						{label.all} <span class="mono">{cases.length}</span>
					</button>
					{
						filters.map((f) => (
							<button type="button" class="w-chip" data-filter={f} aria-pressed="false">
								{label[f]} <span class="mono">{counts[f]}</span>
							</button>
						))
					}
				</div>
				<div class="w-views" role="group" aria-label="Layout">
					<button type="button" class="w-view" data-view-btn="grid" aria-pressed="true">
						<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1" /><rect x="9" y="1" width="6" height="6" rx="1" /><rect x="1" y="9" width="6" height="6" rx="1" /><rect x="9" y="9" width="6" height="6" rx="1" /></svg>
						<span>Grid</span>
					</button>
					<button type="button" class="w-view" data-view-btn="list" aria-pressed="false">
						<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1" y="2" width="14" height="2" rx="1" /><rect x="1" y="7" width="14" height="2" rx="1" /><rect x="1" y="12" width="14" height="2" rx="1" /></svg>
						<span>Index</span>
					</button>
				</div>
			</div>

			<div class="w-views-wrap" data-view="grid">
				<ul class="w-grid" aria-label="Case studies">
					{
						cases.map((c, i) => {
							const d = c.data;
							const buckets = [...new Set(d.disciplines.map(bucket))].join(' ');
							return (
								<li
									class="w-card"
									data-buckets={buckets}
									data-span={SPANS[i % SPANS.length]}
									style={`--c-bg:${d.theme.bg};--c-ink:${d.theme.ink};--c-accent:${d.theme.accent};view-transition-name:card-${c.id}`}
								>
									<a href={`/work/${c.id}`} data-cursor>
										<div class="w-media" style={`view-transition-name: case-media-${c.id}`}>
											<Image
												src={d.cover}
												alt={d.coverAlt}
												widths={[480, 800, 1200]}
												sizes="(max-width: 760px) 100vw, 60vw"
												loading={i < 2 ? 'eager' : 'lazy'}
											/>
										</div>
										<div class="w-card-copy">
											<h2 class="w-card-title">
												<span style={`view-transition-name: case-title-${c.id}`}>{d.title}</span>
											</h2>
											<span class="mono w-year">{d.year}</span>
											<p class="w-card-sum">{d.summary}</p>
											<p class="mono w-tags">
												{d.client} · {d.disciplines.join(', ')}
											</p>
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>

				<ol class="w-list" aria-label="Case studies, index view">
					{
						cases.map((c, i) => {
							const d = c.data;
							const buckets = [...new Set(d.disciplines.map(bucket))].join(' ');
							return (
								<li data-buckets={buckets} style={`--c-accent:${d.theme.accent}`}>
									<a href={`/work/${c.id}`} data-preview={previews[i].src} data-cursor>
										<span class="mono w-n">{String(i + 1).padStart(2, '0')}</span>
										<span class="w-l-title">{d.title}</span>
										<span class="w-l-client">{d.client}</span>
										<span class="mono w-l-tags">{d.disciplines.join(', ')}</span>
										<span class="mono w-l-year">{d.year}</span>
										<span class="w-l-arrow" aria-hidden="true">→</span>
									</a>
								</li>
							);
						})
					}
				</ol>
				<p class="w-empty" hidden>Nothing here yet.</p>
			</div>

			<section class="w-archive" aria-labelledby="archive-title">
				<div class="w-archive-head">
					<h2 id="archive-title">More projects</h2>
					<p class="mono">Smaller builds and experiments</p>
				</div>
				<table>
					<thead class="sr-only">
						<tr><th>Project</th><th>What</th><th>For</th><th>Year</th></tr>
					</thead>
					<tbody>
						{
							archive.map((a) => (
								<tr>
									<th scope="row">{a.name}</th>
									<td>{a.what}</td>
									<td class="mono">{a.for}</td>
									<td class="mono">{a.year}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<section class="w-cta">
				<p class="mono">Have a project in mind?</p>
				<a href="/about" class="w-cta-link">Let's make something <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<Footer />

		<div class="w-float" aria-hidden="true">
			<img alt="" />
			<span class="w-float-label mono">View</span>
		</div>

		<script>
			const wrap = document.querySelector<HTMLElement>('[data-view]')!;
			const cards = [...document.querySelectorAll<HTMLElement>('.w-card')];
			const rows = [...document.querySelectorAll<HTMLElement>('.w-list li')];
			const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
			const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-view-btn]')];
			const empty = document.querySelector<HTMLElement>('.w-empty')!;
			const SPANS = [7, 5, 5, 7, 6, 6];
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

			const withTransition = (fn: () => void) => {
				const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
				if (doc.startViewTransition && !reduce) doc.startViewTransition(fn);
				else fn();
			};

			function applyFilter(f: string) {
				let shown = 0;
				cards.forEach((card) => {
					const on = f === 'all' || (card.dataset.buckets ?? '').split(' ').includes(f);
					card.hidden = !on;
					if (on) card.dataset.span = String(SPANS[shown++ % SPANS.length]);
				});
				// A lone card at the end of a row should fill it.
				const visible = cards.filter((c) => !c.hidden);
				if (visible.length % 2 === 1) visible.at(-1)!.dataset.span = '12';
				rows.forEach((row) => {
					row.hidden = !(f === 'all' || (row.dataset.buckets ?? '').split(' ').includes(f));
				});
				chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === f)));
				empty.hidden = shown > 0;
				const url = new URL(location.href);
				if (f === 'all') url.searchParams.delete('filter');
				else url.searchParams.set('filter', f);
				history.replaceState(null, '', url);
			}

			function setView(v: string) {
				wrap.dataset.view = v;
				viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === v)));
				try {
					localStorage.setItem('work-view', v);
				} catch {
					/* storage unavailable */
				}
			}

			chips.forEach((c) => c.addEventListener('click', () => withTransition(() => applyFilter(c.dataset.filter!))));
			viewBtns.forEach((b) => b.addEventListener('click', () => withTransition(() => setView(b.dataset.viewBtn!))));

			const initialFilter = new URL(location.href).searchParams.get('filter');
			if (initialFilter && chips.some((c) => c.dataset.filter === initialFilter)) applyFilter(initialFilter);
			else applyFilter('all');
			try {
				const saved = localStorage.getItem('work-view');
				if (saved === 'list' || saved === 'grid') setView(saved);
			} catch {
				/* storage unavailable */
			}

			// Floating cursor: a "View" bubble on grid cards, an image preview on index rows.
			const float = document.querySelector<HTMLElement>('.w-float')!;
			const floatImg = float.querySelector('img')!;
			const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
			if (fine) {
				let x = 0,
					y = 0,
					tx = 0,
					ty = 0,
					raf = 0;
				const loop = () => {
					x += (tx - x) * (reduce ? 1 : 0.18);
					y += (ty - y) * (reduce ? 1 : 0.18);
					float.style.transform = `translate3d(${x}px, ${y}px, 0)`;
					raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(loop) : 0;
				};
				document.querySelectorAll<HTMLAnchorElement>('[data-cursor]').forEach((a) => {
					a.addEventListener('pointerenter', (e) => {
						const preview = a.dataset.preview;
						float.dataset.mode = preview ? 'preview' : 'bubble';
						if (preview) floatImg.src = preview;
						tx = x = e.clientX;
						ty = y = e.clientY;
						float.classList.add('on');
						loop();
					});
					a.addEventListener('pointermove', (e) => {
						tx = e.clientX;
						ty = e.clientY;
						if (!raf) raf = requestAnimationFrame(loop);
					});
					a.addEventListener('pointerleave', () => float.classList.remove('on'));
				});
			}
		</script>

		<style>
			html body main.w {
				max-width: 1320px;
				padding-top: calc(74px + clamp(2.5rem, 7vw, 5rem));
			}

			.w-intro {
				display: grid;
				grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
				gap: 1.5rem clamp(2rem, 5vw, 4rem);
				align-items: end;
				padding-bottom: clamp(2rem, 5vw, 3.5rem);
			}

			.w-title {
				margin: 0;
				font-size: clamp(5rem, 19vw, 15rem);
				line-height: 0.8;
				letter-spacing: -0.065em;
				color: var(--green);
			}

			.w-title sup {
				font-size: clamp(0.85rem, 1.4vw, 1.1rem);
				letter-spacing: 0.04em;
				vertical-align: top;
				margin-left: 0.4em;
				position: relative;
				top: 0.6em;
				color: var(--black);
			}

			.w-lede {
				margin: 0 0 1rem;
				font-family: 'Space Grotesk', system-ui, sans-serif;
				font-size: clamp(1.2rem, 2vw, 1.55rem);
				line-height: 1.3;
				letter-spacing: -0.015em;
				text-wrap: pretty;
			}

			.w-where {
				margin: 0;
				color: var(--gray);
			}

			/* Toolbar */
			.w-toolbar {
				position: sticky;
				top: 74px;
				z-index: 20;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
				margin: 0 calc(-1 * clamp(0.5rem, 1.5vw, 1rem)) clamp(1.5rem, 3vw, 2.5rem);
				padding: 0.75rem clamp(0.5rem, 1.5vw, 1rem);
				background: color-mix(in oklab, var(--bg) 88%, transparent);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-bottom: 2px solid var(--green);
			}

			.w-filters,
			.w-views {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}

			.w-chip,
			.w-view {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.45rem 0.9rem;
				border-radius: 999px;
				border: 1.5px solid var(--gray-light);
				background: transparent;
				color: var(--black);
				font: 600 0.95rem/1 'Space Grotesk', system-ui, sans-serif;
				cursor: pointer;
				transition:
					background 0.2s ease,
					border-color 0.2s ease,
					color 0.2s ease;
			}

			.w-chip .mono {
				font-size: 0.7rem;
				color: var(--gray);
			}

			.w-chip:hover,
			.w-view:hover {
				border-color: var(--green);
			}

			.w-chip[aria-pressed='true'],
			.w-view[aria-pressed='true'] {
				background: var(--green);
				border-color: var(--green);
				color: var(--white);
			}

			.w-chip[aria-pressed='true'] .mono {
				color: color-mix(in oklab, var(--white) 75%, var(--green));
			}

			.w-chip:focus-visible,
			.w-view:focus-visible {
				outline: 2px solid var(--green-dark);
				outline-offset: 2px;
			}

			.w-view svg {
				width: 14px;
				height: 14px;
				fill: currentColor;
			}

			/* Grid view */
			.w-grid {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1rem, 2.5vw, 2rem);
			}

			[data-view='list'] .w-grid,
			[data-view='grid'] .w-list {
				display: none;
			}

			.w-card {
				grid-column: span 6;
				margin: 0;
				min-width: 0;
			}

			.w-card[data-span='7'] {
				grid-column: span 7;
			}
			.w-card[data-span='5'] {
				grid-column: span 5;
			}
			.w-card[data-span='12'] {
				grid-column: 1 / -1;
			}

			.w-card[data-span='5'] {
				padding-top: clamp(0rem, 6vw, 5rem);
			}

			.w-card a {
				display: block;
				color: var(--black);
				text-decoration: none;
			}

			.w-media {
				position: relative;
				overflow: hidden;
				border-radius: 16px;
				background: var(--c-bg);
				aspect-ratio: 4 / 3;
			}

			.w-card[data-span='12'] .w-media {
				aspect-ratio: 21 / 9;
			}

			.w-media::after {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: inherit;
				box-shadow: inset 0 0 0 0 var(--c-accent);
				transition: box-shadow 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
				pointer-events: none;
			}

			.w-media :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: scale 0.8s cubic-bezier(0.2, 0.7, 0.1, 1);
			}

			.w-card a:hover .w-media :global(img),
			.w-card a:focus-visible .w-media :global(img) {
				scale: 1.045;
			}

			.w-card a:hover .w-media::after,
			.w-card a:focus-visible .w-media::after {
				box-shadow: inset 0 0 0 6px var(--c-accent);
			}

			.w-card a:focus-visible {
				outline: none;
			}

			.w-card a:focus-visible .w-card-title {
				text-decoration: underline;
				text-decoration-color: var(--green);
				text-underline-offset: 4px;
			}

			.w-card-copy {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 0.35rem 1rem;
				padding-top: 1rem;
			}

			.w-card-title {
				margin: 0;
				font-size: clamp(1.5rem, 2.6vw, 2.1rem);
				line-height: 1.05;
				letter-spacing: -0.035em;
				color: var(--black);
			}

			.w-card-title span {
				display: inline-block;
			}

			.w-year {
				color: var(--gray);
				padding-top: 0.5em;
			}

			.w-card-sum {
				grid-column: 1 / -1;
				margin: 0.25rem 0 0;
				max-width: 52ch;
				color: var(--gray);
				font-size: 1rem;
				line-height: 1.5;
			}

			.w-tags {
				grid-column: 1 / -1;
				margin: 0.25rem 0 0;
				color: var(--green);
			}

			/* Index (list) view */
			.w-list {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 2px solid var(--green);
			}

			.w-list li {
				margin: 0;
				border-bottom: 1px solid var(--gray-light);
			}

			.w-list a {
				display: grid;
				grid-template-columns: 3rem minmax(0, 2.2fr) minmax(0, 1.2fr) minmax(0, 1.2fr) 5.5rem 2rem;
				align-items: baseline;
				gap: 1rem;
				padding: 1.35rem 0.5rem;
				color: var(--black);
				text-decoration: none;
				transition:
					background 0.3s ease,
					padding 0.3s cubic-bezier(0.2, 0.7, 0.1, 1);
			}

			.w-list a:hover,
			.w-list a:focus-visible {
				background: color-mix(in oklab, var(--c-accent) 12%, transparent);
				padding-left: 1.25rem;
				outline: none;
			}

			.w-n,
			.w-l-tags,
			.w-l-year {
				color: var(--gray);
			}

			.w-l-title {
				font-family: 'Space Grotesk', system-ui, sans-serif;
				font-size: clamp(1.4rem, 3.4vw, 2.6rem);
				font-weight: 700;
				letter-spacing: -0.04em;
				line-height: 1;
				transition: color 0.25s ease;
			}

			.w-list a:hover .w-l-title {
				color: var(--c-accent);
			}

			.w-l-client {
				color: var(--gray);
			}

			.w-l-arrow {
				justify-self: end;
				color: var(--green);
				transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.1, 1);
			}

			.w-list a:hover .w-l-arrow {
				transform: translateX(6px);
			}

			.w-empty {
				padding: 3rem 0;
				color: var(--gray);
			}

			/* Floating cursor */
			.w-float {
				position: fixed;
				left: 0;
				top: 0;
				z-index: 90;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.2s ease;
			}

			.w-float.on {
				opacity: 1;
			}

			.w-float img,
			.w-float-label {
				position: absolute;
				transition:
					scale 0.3s cubic-bezier(0.2, 0.7, 0.1, 1),
					opacity 0.2s ease;
			}

			.w-float-label {
				display: grid;
				place-items: center;
				width: 5.5rem;
				height: 5.5rem;
				margin: -2.75rem 0 0 -2.75rem;
				border-radius: 50%;
				background: var(--green);
				color: var(--white);
				scale: 0.4;
			}

			.w-float.on[data-mode='bubble'] .w-float-label {
				scale: 1;
			}

			.w-float img {
				max-width: none;
				width: 22rem;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				border-radius: 12px;
				margin: -8.25rem 0 0 2rem;
				box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.35);
				opacity: 0;
				scale: 0.85;
				rotate: -3deg;
			}

			.w-float[data-mode='preview'] .w-float-label {
				opacity: 0;
			}

			.w-float.on[data-mode='preview'] img {
				opacity: 1;
				scale: 1;
			}

			/* Archive */
			.w-archive {
				margin-top: clamp(5rem, 12vw, 9rem);
			}

			.w-archive-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				flex-wrap: wrap;
				padding-bottom: 1rem;
				border-bottom: 2px solid var(--green);
			}

			.w-archive-head h2 {
				margin: 0;
				font-size: clamp(1.75rem, 3.5vw, 2.5rem);
			}

			.w-archive-head p {
				margin: 0;
				color: var(--gray);
			}

			.w-archive table {
				width: 100%;
				border-collapse: collapse;
			}

			.w-archive tr {
				border-bottom: 1px solid var(--gray-light);
			}

			.w-archive th,
			.w-archive td {
				padding: 1rem 0.5rem 1rem 0;
				text-align: left;
				vertical-align: baseline;
			}

			.w-archive th {
				font-family: 'Space Grotesk', system-ui, sans-serif;
				font-size: 1.2rem;
				letter-spacing: -0.02em;
				width: 26%;
			}

			.w-archive td {
				color: var(--gray);
				font-size: 0.98rem;
			}

			.w-archive td.mono:last-child {
				text-align: right;
				white-space: nowrap;
			}

			/* CTA */
			.w-cta {
				margin-top: clamp(4rem, 10vw, 8rem);
				padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
				border-radius: 20px;
				background: var(--green);
				color: var(--white);
			}

			.w-cta .mono {
				margin: 0 0 1rem;
				color: color-mix(in oklab, var(--white) 70%, var(--green));
			}

			.w-cta-link {
				display: inline-flex;
				gap: 0.4em;
				font-family: 'Space Grotesk', system-ui, sans-serif;
				font-weight: 700;
				font-size: clamp(2rem, 6vw, 4.75rem);
				line-height: 1;
				letter-spacing: -0.045em;
				color: var(--white);
			}

			.w-cta-link:hover {
				color: var(--white);
			}

			.w-cta-link span {
				transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
			}

			.w-cta-link:hover span {
				transform: translateX(0.2em);
			}

			@media (max-width: 860px) {
				.w-intro {
					grid-template-columns: 1fr;
				}
				.w-card,
				.w-card[data-span] {
					grid-column: 1 / -1;
					padding-top: 0;
				}
				.w-card[data-span='12'] .w-media {
					aspect-ratio: 4 / 3;
				}
				.w-list a {
					grid-template-columns: 2.25rem minmax(0, 1fr) auto;
				}
				.w-l-client,
				.w-l-tags,
				.w-l-arrow {
					display: none;
				}
				.w-archive th {
					width: auto;
				}
				.w-archive td:nth-child(3) {
					display: none;
				}
				.w-toolbar {
					top: 66px;
				}
			}
		</style>
	</body>
</html>
