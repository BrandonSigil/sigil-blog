---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_LOCATION, SITE_TITLE } from '../consts';
import alexPortrait from '../assets/about/alex-sigil.jpg';
import brandonPortrait from '../assets/about/brandon-sigil.jpg';
import couplePhoto from '../assets/about/sigil-couple.jpg';

const siteUrl = Astro.site?.href ?? 'https://sigil.studio';
const aboutDescription = `${SITE_TITLE} is a music blog from Alex and Brandon Wirth in ${SITE_LOCATION}: New Music Friday picks, album reviews, and year-end lists.`;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: `About | ${SITE_TITLE}`,
	url: new URL('/about', siteUrl).href,
	description: aboutDescription,
	mainEntity: {
		'@type': 'Blog',
		name: `${SITE_TITLE} Music Blog`,
		url: new URL('/blog', siteUrl).href,
		description: SITE_DESCRIPTION,
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description={aboutDescription}
			image={couplePhoto}
			structuredData={structuredData}
		/>
		<style>
			.about-hero {
				padding: 1rem 0 2.5rem;
				border-bottom: 1px solid var(--green);
			}

			.eyebrow {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: var(--green);
				margin-bottom: 0.85rem;
			}

			.about-hero-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.25rem;
				align-items: start;
			}

			.about-hero h1 {
				max-width: 15ch;
				margin-bottom: 0;
			}

			.about-hero p {
				max-width: 58ch;
				font-family: var(--font-sans);
				font-size: 20px;
				letter-spacing: -0.01em;
				line-height: 1.5;
				color: var(--ink-soft);
				margin: 0;
				padding-top: 0.15em;
			}

			@media (min-width: 901px) {
				.about-hero-grid {
					grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
					gap: clamp(2rem, 5vw, 4rem);
					column-gap: clamp(2rem, 6vw, 5rem);
					align-items: end;
				}

				.about-hero h1 {
					max-width: none;
				}

				.about-hero p {
					max-width: none;
					padding-top: 0;
				}
			}

			.section {
				padding: 3.5rem 0;
				border-bottom: 1px solid var(--rule-strong);
			}

			.manifesto-couple {
				margin: 0 0 2rem 0;
				border-radius: 8px;
				overflow: hidden;
				box-shadow: var(--shadow-card);
			}

			.manifesto-couple :global(img) {
				display: block;
				width: 100%;
				height: auto;
			}

			.manifesto-copy {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.25rem;
				max-width: 68ch;
			}

			.manifesto-copy p {
				margin: 0;
				font-size: 16px;
				line-height: 1.68;
				color: var(--ink-soft);
			}

			.duo-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.75rem;
			}

			.duo-card {
				border-radius: 8px;
				padding: 1.15rem;
				background: var(--paper-card);
				box-shadow: var(--shadow-card);
				transition:
					transform var(--dur-base) var(--ease-out),
					box-shadow var(--dur-base) var(--ease-out);
			}

			@media (hover: hover) and (pointer: fine) {
				.duo-card:hover {
					transform: translateY(-2px);
					box-shadow: var(--shadow-card-hover);
					transition-duration: var(--dur-fast);
				}

				.duo-card:hover .duo-image :global(img) {
					transform: scale(1.025);
					transition-duration: var(--dur-fast);
				}
			}

			.duo-image {
				border-radius: 6px;
				overflow: hidden;
				aspect-ratio: 1 / 1;
				margin-bottom: 0.9rem;
				background: var(--gray-lighter);
			}

			.duo-image :global(img) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform var(--dur-base) var(--ease-out);
			}

			.duo-intro {
				max-width: 62ch;
				font-size: 17px;
				line-height: 1.55;
				margin: 0.5rem 0 2rem 0;
				color: var(--ink-soft);
			}

			.duo-card h3 {
				font-family: var(--font-display);
				font-weight: 600;
				letter-spacing: -0.02em;
				line-height: 1.2;
				margin: 0;
				color: var(--green);
			}

			.cta-band {
				--cta-tan: #f7f6f1;
				margin: 3.5rem 0 0;
				border-radius: 8px;
				padding: 2rem 2.25rem;
				background: var(--green);
				color: var(--cta-tan);
				box-shadow: 0 12px 28px -12px rgba(36, 74, 35, 0.35);
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.25rem;
			}

			.cta-band h2 {
				color: var(--cta-tan);
				margin: 0;
			}

			.cta-band .btn {
				background: var(--cta-tan);
				color: var(--green-dark);
				border-color: var(--cta-tan);
				flex-shrink: 0;
			}

			@media (hover: hover) and (pointer: fine) {
				.cta-band .btn:hover {
					background: #ffffff;
					border-color: #ffffff;
					color: var(--green-deep);
				}
			}

			@media (max-width: 900px) {
				.duo-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 768px) {
				.about-hero {
					padding-top: 5.5rem;
				}

				.section {
					padding: 3rem 0;
				}

				.cta-band {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="about-hero">
				<span class="eyebrow">About Sigil</span>
				<div class="about-hero-grid">
					<h1>A music blog about the albums we can't stop playing.</h1>
					<p>
						Sigil comes out of {SITE_LOCATION}. Each New Music Friday we dig through the week's releases and
						write up our favorites, with album reviews and year-end lists in between.
					</p>
				</div>
			</section>

			<section class="section manifesto-section">
				<div class="manifesto-couple">
					<Image src={couplePhoto} alt="Alex and Brandon Wirth" width={1200} height={765} />
				</div>
				<div class="manifesto-copy">
					<h2>Why we write</h2>
					<p>
						More music comes out every week than anyone can keep up with. We listen through the release calendar
						so you can skip straight to the good stuff.
					</p>
					<p>
						We write about what we love: the records that deserve a full listen, front to back, and what makes
						them worth your time.
					</p>
				</div>
			</section>

			<section class="section">
				<h2>Who we are</h2>
				<p class="duo-intro">
					We are Alex and Brandon, a husband and wife in {SITE_LOCATION} with a lot of records and a lot of
					opinions about them.
				</p>
				<div class="duo-grid">
					<article class="duo-card">
						<div class="duo-image">
							<Image src={alexPortrait} alt="Alex Wirth" width={800} height={800} />
						</div>
						<h3>Alex Wirth</h3>
					</article>
					<article class="duo-card">
						<div class="duo-image">
							<Image src={brandonPortrait} alt="Brandon Wirth" width={800} height={800} />
						</div>
						<h3>Brandon Wirth</h3>
					</article>
				</div>
			</section>

			<section class="cta-band">
				<div>
					<h2>Looking for something new to play?</h2>
				</div>
				<a href="/blog" class="btn">Read the blog</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
