---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ListenIcons from '../components/ListenIcons.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import { SITE_TITLE } from '../consts';
import { buildSearchLinks, getUpcomingReleases, groupUpcomingByDate } from '../lib/music';

const releases = getUpcomingReleases();
const grouped = groupUpcomingByDate(releases);
const lanes = [...new Set(releases.map((r) => r.lane))].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Release Calendar | ${SITE_TITLE}`}
			description="Upcoming albums on Sigil’s release radar — grouped by Friday with lane filters and a subscribable .ics calendar feed."
		/>
		<style>
			.cal-hero {
				padding-bottom: 2rem;
				margin-bottom: 2rem;
				border-bottom: 1px solid var(--green);
			}

			.cal-hero-row {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 1.5rem;
				flex-wrap: wrap;
			}

			.cal-hero h1 {
				margin: 0.35rem 0 0.65rem;
			}

			.cal-hero p {
				margin: 0;
				font-family: var(--font-sans);
				font-size: 20px;
				letter-spacing: -0.01em;
				line-height: 1.5;
				color: var(--ink-soft);
				max-width: 54ch;
			}

			.cal-hero-actions {
				display: flex;
				gap: 0.65rem;
				flex-wrap: wrap;
			}

			.lane-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-bottom: 2.25rem;
			}

			.lane-pill {
				border: 1px solid var(--rule-strong);
				background: transparent;
				color: var(--ink);
				font-family: var(--font-mono);
				font-size: 11.5px;
				font-weight: 500;
				padding: 0.4rem 0.85rem;
				border-radius: 5px;
				cursor: pointer;
				font-variant-numeric: tabular-nums;
				transition:
					transform var(--dur-press) var(--ease-out),
					color var(--dur-fast) var(--ease-out),
					border-color var(--dur-fast) var(--ease-out),
					background-color var(--dur-fast) var(--ease-out);
			}

			@media (hover: hover) and (pointer: fine) {
				.lane-pill:hover {
					border-color: var(--green);
					color: var(--green-dark);
				}
			}

			.lane-pill:active {
				transform: scale(0.96);
			}

			.lane-pill.is-active {
				background: var(--green);
				border-color: var(--green);
				color: var(--white);
			}

			.calendar-ledger {
				background: var(--paper-card);
				border-radius: 7px;
				box-shadow: var(--shadow-card);
				overflow: hidden;
			}

			.release-day-group {
				display: grid;
				grid-template-columns: 120px minmax(0, 1fr);
				border-top: 1px solid var(--rule-strong);
			}

			.release-day-group:first-child {
				border-top: none;
			}

			.day-col {
				padding: 1rem 1.1rem;
				border-right: 1px solid var(--rule);
				background: var(--green-tint);
			}

			.day-sticky {
				position: sticky;
				top: 5.5rem;
			}

			.day-date {
				font-family: var(--font-mono);
				font-size: 13px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--green);
				line-height: 1.2;
				margin: 0;
			}

			.day-items {
				min-width: 0;
			}

			.release-row {
				position: relative;
				padding: 0.72rem 1.25rem;
				border-top: 1px solid var(--rule);
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1.25rem;
			}

			.release-row:first-child {
				border-top: none;
			}

			.release-info {
				min-width: 0;
				flex: 1;
			}

			.release-title-line {
				font-size: 15.5px;
				line-height: 1.35;
				color: var(--ink);
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.35rem;
			}

			.release-title-line strong {
				font-family: var(--font-display);
				font-weight: 600;
				letter-spacing: -0.02em;
			}

			.release-dash {
				color: var(--gray);
			}

			.release-meta-inline {
				font-family: var(--font-mono);
				font-size: 11px;
				color: var(--gray);
				margin-left: 0.2rem;
			}

			.release-why {
				margin: 0.2rem 0 0;
				font-size: 14px;
				line-height: 1.5;
				color: var(--ink-soft);
			}

			.release-right {
				display: flex;
				align-items: center;
				gap: 0.85rem;
				flex-shrink: 0;
			}

			.release-lane-tag {
				font-family: var(--font-mono);
				font-size: 11px;
				padding: 0.18rem 0.52rem;
				border-radius: 999px;
				background: var(--gray-lighter);
				color: var(--ink-soft);
				white-space: nowrap;
			}

			@media (max-width: 820px) {
				.release-day-group {
					grid-template-columns: 1fr;
				}

				.day-col {
					padding: 0.65rem 1rem;
					border-right: none;
					border-bottom: 1px solid var(--rule);
					display: flex;
					justify-content: space-between;
					align-items: baseline;
				}

				.day-sticky {
					position: static;
					display: flex;
					width: 100%;
					justify-content: space-between;
					align-items: baseline;
				}

				.release-row {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.65rem;
					padding: 0.9rem 1rem;
				}

				.release-right {
					width: 100%;
					justify-content: space-between;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="cal-hero">
				<div class="cal-hero-row">
					<div>
						<span class="kicker">Release Radar</span>
						<h1>Upcoming releases</h1>
						<p>
							{releases.length} forthcoming albums on our radar, bundled by Friday. Subscribe to the live feed in Apple
							Calendar or Google Calendar.
						</p>
					</div>
					<div class="cal-hero-actions">
						<a href="/releases.ics" class="btn" download>↓ Subscribe (.ics)</a>
						<a href="/blog" class="btn btn-outline">Latest NMF →</a>
					</div>
				</div>
			</section>

			<div class="lane-bar" role="tablist" aria-label="Filter releases by lane" data-glide-group>
				<button type="button" class="lane-pill is-active" data-lane-filter="all">
					All lanes ({releases.length})
				</button>
				{lanes.map((lane) => (
					<button type="button" class="lane-pill" data-lane-filter={lane}>
						{lane} ({releases.filter((r) => r.lane === lane).length})
					</button>
				))}
			</div>

			<div class="calendar-ledger" data-glide-list>
				{grouped.map((group) => (
					<section class="release-day-group" data-day-group style="margin-bottom:0;">
						<div class="day-col">
							<div class="day-sticky">
								<h2 class="day-date">{group.abbrevDate}</h2>
							</div>
						</div>
						<div class="day-items">
							{group.items.map((item) => {
								const links = buildSearchLinks(item.artist, item.title);
								return (
									<article class="release-row" data-release-row data-glide-row data-lane={item.lane}>
										<div class="release-info">
											<div class="release-title-line">
												<strong>{item.artist}</strong>
												<span class="release-dash">—</span>
												<span>{item.title}</span>
												<span class="release-meta-inline">
													{item.type}
													{item.label ? ` · ${item.label}` : ''}
												</span>
											</div>
										</div>
										<div class="release-right">
											<span class="release-lane-tag">{item.lane}</span>
											<ListenIcons
												spotifyUrl={links.spotifyUrl}
												youtubeUrl={links.youtubeUrl}
												bandcampUrl={links.bandcampUrl}
												appleMusicUrl={links.appleMusicUrl}
												labelPrefix={`${item.artist} — ${item.title}`}
												compact={true}
											/>
										</div>
									</article>
								);
							})}
						</div>
					</section>
				))}
			</div>

			<section style="margin-top: 4.5rem;">
				<NewsletterStrip compact={true} />
			</section>
		</main>
		<Footer />

		<script>
			const pills = document.querySelectorAll<HTMLButtonElement>('[data-lane-filter]');
			const groups = document.querySelectorAll<HTMLElement>('[data-day-group]');

			pills.forEach((pill) => {
				pill.addEventListener('click', () => {
					pills.forEach((p) => p.classList.remove('is-active'));
					pill.classList.add('is-active');
					const lane = pill.dataset.laneFilter ?? 'all';

					groups.forEach((group) => {
						const rows = group.querySelectorAll<HTMLElement>('[data-release-row]');
						let visible = 0;
						rows.forEach((row) => {
							const show = lane === 'all' || row.dataset.lane === lane;
							row.classList.toggle('is-hidden', !show);
							row.hidden = !show;
							if (show) visible++;
						});
						group.classList.toggle('is-hidden', visible === 0);
						group.hidden = visible === 0;
					});
				});
			});
		</script>
	</body>
</html>
