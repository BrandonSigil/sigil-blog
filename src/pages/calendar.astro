---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ListenIcons from '../components/ListenIcons.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import { SITE_TITLE } from '../consts';
import { buildSearchLinks, getUpcomingReleases, groupUpcomingByDate } from '../lib/music';

const allReleases = await getUpcomingReleases({ scope: 'all' });
const radarReleases = allReleases.filter((r) => r.isRadar);
const grouped = groupUpcomingByDate(allReleases);
const lanes = [...new Set(allReleases.map((r) => r.lane).filter(Boolean))].sort();

const seenMonths = new Set<string>();
const groupedWithAnchors = grouped.map((group) => {
	const month = group.date.slice(0, 7);
	const monthAnchor = !seenMonths.has(month) ? `m-${month}` : undefined;
	seenMonths.add(month);
	const hasRadar = group.items.some((item) => item.isRadar);
	return { ...group, monthAnchor, hasRadar };
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Release Calendar | ${SITE_TITLE}`}
			description="Upcoming albums on Sigil’s release calendar — updated daily, grouped by date with lane filters and a subscribable .ics feed."
		/>
		<style>
			.cal-hero {
				padding-bottom: 2rem;
				margin-bottom: 1.75rem;
				border-bottom: 1px solid var(--green);
			}

			.cal-hero-row {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 1.5rem;
				flex-wrap: wrap;
			}

			.cal-hero h1 {
				margin: 0.35rem 0 0.65rem;
			}

			.cal-hero p {
				margin: 0;
				font-family: var(--font-sans);
				font-size: 20px;
				letter-spacing: -0.01em;
				line-height: 1.5;
				color: var(--ink-soft);
				max-width: 56ch;
			}

			.cal-hero-actions {
				display: flex;
				gap: 0.65rem;
				flex-wrap: wrap;
			}

			.cal-controls {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem 1.5rem;
				flex-wrap: wrap;
				margin-bottom: 2rem;
			}

			.scope-switch {
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				padding: 0.22rem;
				border: 1px solid var(--rule-strong);
				border-radius: 7px;
				background: var(--paper-card);
			}

			.scope-btn {
				border: none;
				background: transparent;
				color: var(--ink-soft);
				font-family: var(--font-mono);
				font-size: 11.5px;
				font-weight: 500;
				padding: 0.36rem 0.78rem;
				border-radius: 5px;
				cursor: pointer;
				font-variant-numeric: tabular-nums;
				transition:
					transform var(--dur-press) var(--ease-out),
					color var(--dur-fast) var(--ease-out),
					background-color var(--dur-fast) var(--ease-out);
			}

			@media (hover: hover) and (pointer: fine) {
				.scope-btn:hover {
					color: var(--green-dark);
				}
			}

			.scope-btn:active {
				transform: scale(0.96);
			}

			.scope-btn.is-active {
				background: var(--green);
				color: var(--white);
			}

			.lane-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}

			.lane-pill {
				border: 1px solid var(--rule-strong);
				background: transparent;
				color: var(--ink);
				font-family: var(--font-mono);
				font-size: 11.5px;
				font-weight: 500;
				padding: 0.38rem 0.8rem;
				border-radius: 5px;
				cursor: pointer;
				font-variant-numeric: tabular-nums;
				transition:
					transform var(--dur-press) var(--ease-out),
					color var(--dur-fast) var(--ease-out),
					border-color var(--dur-fast) var(--ease-out),
					background-color var(--dur-fast) var(--ease-out);
			}

			@media (hover: hover) and (pointer: fine) {
				.lane-pill:hover {
					border-color: var(--green);
					color: var(--green-dark);
				}
			}

			.lane-pill:active {
				transform: scale(0.96);
			}

			.lane-pill.is-active {
				background: var(--green);
				border-color: var(--green);
				color: var(--white);
			}

			.calendar-ledger {
				background: var(--paper-card);
				border-radius: 7px;
				box-shadow: var(--shadow-card);
				overflow: hidden;
			}

			.release-day-group {
				display: grid;
				grid-template-columns: 120px minmax(0, 1fr);
				border-top: 1px solid var(--rule-strong);
				scroll-margin-top: 5.5rem;
			}

			.release-day-group:first-child {
				border-top: none;
			}

			.day-col {
				padding: 1rem 1.1rem;
				border-right: 1px solid var(--rule);
				background: var(--green-tint);
			}

			.day-sticky {
				position: sticky;
				top: 5.5rem;
			}

			.day-date {
				font-family: var(--font-mono);
				font-size: 13px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--green);
				line-height: 1.2;
				margin: 0;
				font-variant-numeric: tabular-nums;
			}

			.day-items {
				min-width: 0;
			}

			.release-row {
				position: relative;
				padding: 0.72rem 1.25rem;
				border-top: 1px solid var(--rule);
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1.25rem;
			}

			.release-row:first-child {
				border-top: none;
			}

			.release-info {
				min-width: 0;
				flex: 1;
			}

			.release-title-line {
				font-size: 15.5px;
				line-height: 1.35;
				color: var(--ink);
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.35rem;
			}

			.release-title-line strong {
				font-family: var(--font-display);
				font-weight: 600;
				letter-spacing: -0.02em;
			}

			.release-dash {
				color: var(--gray);
			}

			.release-meta-inline {
				font-family: var(--font-mono);
				font-size: 11px;
				color: var(--gray);
				margin-left: 0.2rem;
			}

			.release-right {
				display: flex;
				align-items: center;
				gap: 0.85rem;
				flex-shrink: 0;
			}

			.release-lane-tag {
				font-family: var(--font-mono);
				font-size: 11px;
				padding: 0.18rem 0.52rem;
				border-radius: 999px;
				background: var(--gray-lighter);
				color: var(--ink-soft);
				white-space: nowrap;
			}

			@media (max-width: 820px) {
				.release-day-group {
					grid-template-columns: 1fr;
				}

				.day-col {
					padding: 0.65rem 1rem;
					border-right: none;
					border-bottom: 1px solid var(--rule);
				}

				.day-sticky {
					position: static;
				}

				.release-row {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.65rem;
					padding: 0.9rem 1rem;
				}

				.release-right {
					width: 100%;
					justify-content: space-between;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="cal-hero">
				<div class="cal-hero-row">
					<div>
						<span class="kicker">Release Calendar</span>
						<h1>Upcoming releases</h1>
						<p>
							Forthcoming albums tracked daily, bundled by release date. Subscribe to the radar feed in Apple Calendar
							or Google Calendar.
						</p>
					</div>
					<div class="cal-hero-actions">
						<a href="/releases.ics" class="btn" download>↓ Subscribe (.ics)</a>
						<a href="/blog" class="btn btn-outline">Latest NMF →</a>
					</div>
				</div>
			</section>

			<div class="cal-controls">
				<div class="scope-switch" role="group" aria-label="Calendar scope" data-glide-group>
					<button type="button" class="scope-btn is-active" data-scope-btn="radar" aria-pressed="true">
						On our radar ({radarReleases.length})
					</button>
					<button type="button" class="scope-btn" data-scope-btn="all" aria-pressed="false">
						All releases ({allReleases.length})
					</button>
				</div>

				<div class="lane-bar" role="tablist" aria-label="Filter releases by lane" data-glide-group>
					<button type="button" class="lane-pill is-active" data-lane-filter="all">
						All lanes
					</button>
					{lanes.map((lane) => (
						<button type="button" class="lane-pill" data-lane-filter={lane}>
							{lane}
						</button>
					))}
				</div>
			</div>

			<div class="calendar-ledger" data-glide-list>
				{groupedWithAnchors.map((group) => (
					<section
						id={group.monthAnchor}
						class:list={['release-day-group', { 'is-hidden': !group.hasRadar }]}
						hidden={!group.hasRadar}
						data-day-group
						style="margin-bottom:0;"
					>
						<div class="day-col">
							<div class="day-sticky">
								<h2 class="day-date">{group.abbrevDate}</h2>
							</div>
						</div>
						<div class="day-items">
							{group.items.map((item) => {
								const links = buildSearchLinks(item.artist, item.title);
								const metaParts = [item.type, item.label].filter(Boolean).join(' · ');
								return (
									<article
										class:list={['release-row', { 'is-hidden': !item.isRadar }]}
										hidden={!item.isRadar}
										data-release-row
										data-glide-row
										data-radar={item.isRadar ? '1' : '0'}
										data-lane={item.lane}
									>
										<div class="release-info">
											<div class="release-title-line">
												<strong>{item.artist}</strong>
												<span class="release-dash">—</span>
												<span>{item.title}</span>
												{metaParts && <span class="release-meta-inline">{metaParts}</span>}
											</div>
										</div>
										<div class="release-right">
											{item.lane && <span class="release-lane-tag">{item.lane}</span>}
											<ListenIcons
												spotifyUrl={links.spotifyUrl}
												youtubeUrl={links.youtubeUrl}
												bandcampUrl={links.bandcampUrl}
												appleMusicUrl={links.appleMusicUrl}
												labelPrefix={`${item.artist} — ${item.title}`}
												compact={true}
											/>
										</div>
									</article>
								);
							})}
						</div>
					</section>
				))}
			</div>

			<section style="margin-top: 4.5rem;">
				<NewsletterStrip compact={true} />
			</section>
		</main>
		<Footer />

		<script>
			const scopeBtns = document.querySelectorAll<HTMLButtonElement>('[data-scope-btn]');
			const lanePills = document.querySelectorAll<HTMLButtonElement>('[data-lane-filter]');
			const groups = document.querySelectorAll<HTMLElement>('[data-day-group]');

			let activeScope: 'radar' | 'all' = 'radar';
			let activeLane = 'all';

			const applyFilters = () => {
				groups.forEach((group) => {
					const rows = group.querySelectorAll<HTMLElement>('[data-release-row]');
					let visible = 0;
					rows.forEach((row) => {
						const matchesScope = activeScope === 'all' || row.dataset.radar === '1';
						const matchesLane = activeLane === 'all' || row.dataset.lane === activeLane;
						const show = matchesScope && matchesLane;
						row.classList.toggle('is-hidden', !show);
						row.hidden = !show;
						if (show) visible++;
					});
					group.classList.toggle('is-hidden', visible === 0);
					group.hidden = visible === 0;
				});
			};

			scopeBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					activeScope = (btn.dataset.scopeBtn as 'radar' | 'all') ?? 'radar';
					scopeBtns.forEach((b) => {
						const isCurrent = b === btn;
						b.classList.toggle('is-active', isCurrent);
						b.setAttribute('aria-pressed', String(isCurrent));
					});
					applyFilters();
				});
			});

			lanePills.forEach((pill) => {
				pill.addEventListener('click', () => {
					activeLane = pill.dataset.laneFilter ?? 'all';
					lanePills.forEach((p) => p.classList.toggle('is-active', p === pill));
					applyFilters();
				});
			});
		</script>
	</body>
</html>
