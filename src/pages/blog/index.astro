---
import BaseHead from '../../components/BaseHead.astro';
import FeaturedCard from '../../components/FeaturedCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`All posts | ${SITE_TITLE}`} description="Every New Music Friday, album review and list on Sigil, newest first." />
		<style>
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 2rem;
				flex-wrap: wrap;
				gap: 1rem;
			}
			
			.section-header h1 {
				margin: 0;
			}
			
			.section-header p {
				color: var(--gray);
				font-size: 1.1rem;
				margin: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="section-header">
				<h1>All posts</h1>
			</div>

			<div class="posts-list">
				{posts.map((post, index) => (
					<FeaturedCard
						title={post.data.title}
						subtitle={post.data.artist}
						description={post.data.description}
						href={`/blog/${post.id}`}
						image={post.data.heroImage}
						imageAlt={post.data.title}
						reverse={index % 2 === 1}
						badge={post.data.draft ? 'Draft' : undefined}
					/>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
