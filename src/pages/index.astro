---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import NmfPoster from '../components/NmfPoster.astro';
import PostCard from '../components/PostCard.astro';
import UpcomingStrip from '../components/UpcomingStrip.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_STUDIO, SITE_TITLE } from '../consts';
import {
	categoryLabel,
	estimateReadTime,
	formatAbbrevDate,
	formatShortDate,
	getAllCratePicks,
	getPostCoverMosaic,
	getPublishedPosts,
	getSpotlightCover,
	getUpcomingReleases,
	inferCategory,
	parseNmfPost,
} from '../lib/music';

const posts = await getPublishedPosts();
const featured = posts[0];
const desktopPosts = posts.slice(1, 5);
const recentGridPosts = posts.slice(1, 7);

const featuredCat = featured ? inferCategory(featured) : 'nmf';
const featuredParsed = featured && featuredCat === 'nmf' ? parseNmfPost(featured) : null;
const featuredSpotlight = featured ? getSpotlightCover(featured) : undefined;
const featuredPicks = featuredParsed?.albums.slice(0, 4) ?? [];

const latestNmf = posts.find((p) => inferCategory(p) === 'nmf');
const latestPicks = latestNmf ? parseNmfPost(latestNmf).albums.slice(0, 4) : [];

const allCratePicks = await getAllCratePicks();
const crateFolderThumbs = allCratePicks
	.map((p) => p.image)
	.filter((img): img is NonNullable<typeof img> => Boolean(img))
	.slice(0, 3);

const upcoming = getUpcomingReleases();
const nextDrop = upcoming[0];
const nextDropParts = nextDrop ? formatAbbrevDate(nextDrop.releaseDate).split(' ') : ['Dec.', '4'];

const desktopItems = desktopPosts.map((post) => {
	const covers = getPostCoverMosaic(post).slice(0, 3);
	const fallback = inferCategory(post) !== 'nmf' && post.data.heroImage ? [post.data.heroImage] : [];
	return {
		post,
		stack: covers.length > 0 ? covers : fallback,
	};
});

const siteUrl = Astro.site?.href ?? 'https://sigil.studio';
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: siteUrl,
		description: SITE_DESCRIPTION,
		publisher: {
			'@type': 'Organization',
			name: SITE_STUDIO,
			url: siteUrl,
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Blog',
		name: `${SITE_TITLE} Music`,
		url: new URL('/blog', siteUrl).href,
		description: SITE_DESCRIPTION,
		author: { '@type': 'Person', name: SITE_AUTHOR },
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<style is:inline>html, body { background-color: #396e3a; }</style>
		<BaseHead
			title={`${SITE_TITLE} — Music News, Reviews & Weekly Crates`}
			description={SITE_DESCRIPTION}
			structuredData={structuredData}
		/>
		<style>
			body {
				background: var(--bg);
			}

			/* Tactile Green Desktop Hero: Featured Window LEFT + Desktop Icons RIGHT */
			.hero {
				position: relative;
				width: 100%;
				min-height: min(82svh, 680px);
				background-color: #396e3a;
				display: grid;
				place-items: center;
				padding: 6.25rem 1.5rem 3.25rem;
				overflow: hidden;
			}

			.hero-scene {
				position: absolute;
				inset: 0;
				background: radial-gradient(circle at 42% 45%, #4a8249 0%, #396e3a 58%, #2c592e 100%);
			}

			.hero::before {
				content: '';
				position: absolute;
				inset: 0;
				z-index: 4;
				background-image: radial-gradient(rgba(182, 232, 178, 0.14) 1px, transparent 1px);
				background-size: 16px 16px;
				pointer-events: none;
			}

			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				z-index: 5;
				background-image: url('/noise-sigil-white.png');
				background-repeat: repeat;
				opacity: 0.26;
				pointer-events: none;
				mix-blend-mode: screen;
			}

			.desk {
				--d-ink: #14261a;
				--d-paper: #f7f6f1;
				position: relative;
				z-index: 10;
				width: min(100%, 1180px);
				display: grid;
				grid-template-columns: minmax(0, 1fr) 252px;
				gap: 2.25rem;
				align-items: center;
			}

			/* Classic Mac OS System 7 Featured Window */
			.desk-window {
				position: relative;
				display: block;
				width: 100%;
				color: var(--d-ink);
				text-decoration: none;
				background: var(--d-paper);
				border: 2px solid var(--d-ink);
				border-radius: 0 6px 6px 6px;
				box-shadow: 10px 10px 0 rgba(12, 28, 16, 0.42);
				font-family: var(--font-mono);
				transition: box-shadow 0.18s ease, translate 0.18s ease;
			}

			.desk-window:hover,
			.desk-window:focus-visible {
				translate: -3px -3px;
				box-shadow: 14px 14px 0 rgba(12, 28, 16, 0.42);
			}

			.desk-window:focus-visible {
				outline: 2px solid #ffffff;
				outline-offset: 4px;
			}

			.desk-tab {
				position: absolute;
				left: -2px;
				bottom: 100%;
				padding: 0.28rem 1rem 0.18rem 0.78rem;
				background: var(--d-paper);
				border: 2px solid var(--d-ink);
				border-bottom: none;
				border-radius: 6px 14px 0 0;
				font-size: 11px;
				font-weight: 500;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				line-height: 1.4;
			}

			.desk-titlebar {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				height: 2rem;
				padding: 0 0.6rem;
				border-bottom: 1.5px solid var(--d-ink);
			}

			.desk-box {
				flex: none;
				width: 0.74rem;
				height: 0.74rem;
				border: 1.5px solid var(--d-ink);
				background: var(--d-paper);
			}

			.desk-stripes {
				flex: 1;
				height: 0.74rem;
				background: repeating-linear-gradient(to bottom, var(--d-ink) 0 1px, transparent 1px 4px);
			}

			.desk-name {
				flex: none;
				font-size: 11.5px;
				font-weight: 500;
				letter-spacing: 0.04em;
				white-space: nowrap;
			}

			.desk-body {
				display: grid;
				grid-template-columns: minmax(0, 1.32fr) minmax(0, 1fr);
			}

			.desk-art {
				border-right: 1.5px solid var(--d-ink);
				aspect-ratio: 16 / 10;
				overflow: hidden;
				background: #0f110f;
			}

			.desk-art > :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.desk-window:hover .desk-art :global(.poster-art-wrap img) {
				transform: scale(1.03);
			}

			.desk-copy {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.65rem;
				padding: clamp(1.1rem, 2.2vw, 1.65rem);
				min-width: 0;
			}

			.desk-kicker {
				font-size: 11px;
				font-weight: 500;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: var(--green);
			}

			.desk-title {
				margin: 0;
				font-family: var(--font-display);
				font-size: clamp(1.55rem, 2.6vw, 2.25rem);
				font-weight: 700;
				line-height: 0.96;
				letter-spacing: -0.04em;
				color: var(--d-ink);
			}

			.desk-desc {
				margin: 0;
				font-family: var(--font-sans);
				font-size: 15px;
				line-height: 1.58;
				color: #3c4a40;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 3;
				overflow: hidden;
			}

			.desk-footer-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-top: 0.35rem;
			}

			.desk-open {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.42rem 0.9rem;
				border: 1.5px solid var(--d-ink);
				border-radius: 5px;
				background: var(--d-paper);
				box-shadow: 3px 3px 0 var(--d-ink);
				font-size: 12px;
				font-weight: 500;
				letter-spacing: 0.04em;
				transition: background 0.14s ease, color 0.14s ease;
			}

			.desk-window:hover .desk-open {
				background: var(--d-ink);
				color: var(--d-paper);
			}

			.desk-mini-covers {
				display: flex;
				align-items: center;
			}

			.desk-mini-covers :global(img) {
				width: 26px;
				height: 26px;
				border-radius: 3px;
				object-fit: cover;
				border: 1.5px solid var(--d-ink);
				margin-left: -6px;
			}

			.desk-mini-covers :global(img:first-child) {
				margin-left: 0;
			}

			.desk-status {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.34rem 0.75rem;
				border-top: 1.5px solid var(--d-ink);
				font-size: 11px;
				letter-spacing: 0.04em;
				color: #3c4a40;
				white-space: nowrap;
				overflow: hidden;
			}

			.desk-status span:last-child {
				overflow: hidden;
				text-overflow: ellipsis;
			}

			/* Right-side Mac Desktop Icons Grid (stacked images + peeking folder + calendar) */
			.desk-icons {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.35rem 0.9rem;
				list-style: none;
				margin: 0;
				padding: 0;
				align-content: center;
			}

			.desk-icons li {
				margin: 0;
				min-width: 0;
			}

			.desk-file {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
				color: #ffffff;
				text-decoration: none;
			}

			.desk-icon-stage {
				position: relative;
				width: 64px;
				height: 60px;
				display: grid;
				place-items: center;
			}

			/* Stacked image desktop icon (albums fanned like desktop photos) */
			.img-stack {
				position: relative;
				width: 52px;
				height: 52px;
			}

			.img-stack-card {
				position: absolute;
				inset: 0;
				border-radius: 4px;
				overflow: hidden;
				background: var(--d-paper);
				border: 1.5px solid var(--d-ink);
				box-shadow: 2px 2px 0 rgba(12, 28, 16, 0.42);
				transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease;
			}

			.img-stack-card :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.img-stack-card.layer-2 {
				transform: translate(-6px, -4px) rotate(-8deg);
				z-index: 1;
			}

			.img-stack-card.layer-1 {
				transform: translate(6px, -2px) rotate(7deg);
				z-index: 2;
			}

			.img-stack-card.layer-0 {
				transform: translate(0, 2px) rotate(-1deg);
				z-index: 3;
				box-shadow: 3px 3px 0 rgba(12, 28, 16, 0.48);
			}

			.desk-file:hover .img-stack-card.layer-2 {
				transform: translate(-10px, -7px) rotate(-13deg);
			}

			.desk-file:hover .img-stack-card.layer-1 {
				transform: translate(10px, -5px) rotate(11deg);
			}

			.desk-file:hover .img-stack-card.layer-0 {
				transform: translate(0, -1px) rotate(0deg);
				box-shadow: 4px 5px 0 rgba(12, 28, 16, 0.5);
			}

			/* Desktop folder icon with album sleeves peeking out from inside */
			.folder-stack {
				position: relative;
				width: 60px;
				height: 52px;
				filter: drop-shadow(3px 3px 0 rgba(12, 28, 16, 0.44));
			}

			.folder-back {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				height: 44px;
				background: #d8d5c9;
				border: 1.5px solid var(--d-ink);
				border-radius: 3px;
			}

			.folder-back::before {
				content: '';
				position: absolute;
				left: -1.5px;
				bottom: 100%;
				width: 24px;
				height: 7px;
				background: #d8d5c9;
				border: 1.5px solid var(--d-ink);
				border-bottom: none;
				border-radius: 3px 6px 0 0;
			}

			.folder-peek {
				position: absolute;
				width: 28px;
				height: 28px;
				border-radius: 3px;
				overflow: hidden;
				border: 1.5px solid var(--d-ink);
				background: #ffffff;
				transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
			}

			.folder-peek :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.folder-peek.p0 {
				left: 5px;
				top: 6px;
				transform: rotate(-9deg);
				z-index: 2;
			}

			.folder-peek.p1 {
				left: 16px;
				top: 2px;
				transform: rotate(2deg);
				z-index: 3;
			}

			.folder-peek.p2 {
				right: 5px;
				top: 7px;
				transform: rotate(10deg);
				z-index: 2;
			}

			.desk-file:hover .folder-peek.p0 {
				transform: translate(-3px, -6px) rotate(-13deg);
			}

			.desk-file:hover .folder-peek.p1 {
				transform: translate(0, -8px) rotate(0deg);
			}

			.desk-file:hover .folder-peek.p2 {
				transform: translate(3px, -6px) rotate(14deg);
			}

			.folder-front {
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				height: 31px;
				background: var(--d-paper);
				border: 1.5px solid var(--d-ink);
				border-radius: 3px;
				z-index: 4;
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: var(--font-mono);
				font-size: 9px;
				font-weight: 500;
				letter-spacing: 0.08em;
				color: var(--d-ink);
			}

			/* Hardware Calendar Tile Icon */
			.cal-tile-icon {
				width: 50px;
				height: 52px;
				background: var(--d-paper);
				border: 1.5px solid var(--d-ink);
				border-radius: 5px;
				box-shadow: 3px 3px 0 rgba(12, 28, 16, 0.44);
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.16s ease, box-shadow 0.16s ease;
			}

			.desk-file:hover .cal-tile-icon {
				transform: translate(-2px, -2px);
				box-shadow: 5px 5px 0 rgba(12, 28, 16, 0.46);
			}

			.cal-tile-head {
				background: var(--d-ink);
				color: #b7e2b5;
				font-family: var(--font-mono);
				font-size: 9px;
				font-weight: 500;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				text-align: center;
				padding: 3px 0;
				line-height: 1;
			}

			.cal-tile-num {
				flex: 1;
				display: grid;
				place-items: center;
				font-family: var(--font-display);
				font-size: 22px;
				font-weight: 700;
				letter-spacing: -0.04em;
				color: var(--d-ink);
				line-height: 1;
			}

			/* Classic doc SVG fallback (for posts with no album covers) */
			.desk-file-svg {
				width: 44px;
				height: auto;
				overflow: visible;
				filter: drop-shadow(3px 3px 0 rgba(12, 28, 16, 0.44));
				transition: translate 0.14s ease, filter 0.14s ease;
			}

			.desk-file:hover .desk-file-svg {
				translate: -2px -2px;
				filter: drop-shadow(5px 5px 0 rgba(12, 28, 16, 0.48));
			}

			.desk-file-name {
				padding: 0.12rem 0.4rem;
				border-radius: 3px;
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				line-height: 1.3;
				text-align: center;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
				overflow: hidden;
			}

			.desk-file:hover .desk-file-name,
			.desk-file:focus-visible .desk-file-name {
				background: var(--d-ink);
				color: var(--d-paper);
			}

			/* Main Editorial Sections — Crisp 1px Hairlines & Swiss Breathing Room */
			main {
				padding-top: 3.75rem;
			}

			.section-head {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 1.5rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--ink);
			}

			.section-head h2 {
				margin: 0.35rem 0 0;
			}

			.section-head-link {
				font-family: var(--font-mono);
				font-size: 12px;
				font-weight: 500;
				color: var(--green);
			}

			/* Inside this week's crate */
			.crate-shelf {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1.25rem;
			}

			.crate-tile {
				display: flex;
				flex-direction: column;
				text-decoration: none;
				color: inherit;
				background: var(--paper-card);
				border: 1px solid var(--rule-strong);
				border-radius: 6px;
				overflow: hidden;
				transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
			}

			.crate-tile:hover {
				border-color: var(--ink);
				transform: translate(-2px, -2px);
				box-shadow: 4px 4px 0 var(--green);
			}

			.crate-sleeve {
				position: relative;
				aspect-ratio: 1 / 1;
				overflow: hidden;
				border-bottom: 1px solid var(--rule);
				background: var(--gray-lighter);
			}

			.crate-sleeve :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}

			.crate-tile:hover .crate-sleeve :global(img) {
				transform: scale(1.04);
			}

			.crate-num-chip {
				position: absolute;
				top: 0.5rem;
				left: 0.5rem;
				background: var(--paper);
				color: var(--ink);
				border: 1px solid var(--ink);
				font-family: var(--font-mono);
				font-size: 10.5px;
				font-weight: 500;
				padding: 0.1rem 0.38rem;
				border-radius: 3px;
			}

			.crate-info {
				padding: 0.9rem 1rem 1rem;
				display: flex;
				flex-direction: column;
				flex: 1;
			}

			.crate-artist {
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.11em;
				color: var(--green);
				margin-bottom: 0.2rem;
			}

			.crate-album {
				font-family: var(--font-display);
				font-size: 1.08rem;
				font-weight: 600;
				letter-spacing: -0.02em;
				line-height: 1.15;
				color: var(--ink);
				margin: 0 0 0.6rem;
			}

			.crate-tasting {
				margin: auto 0 0;
				padding-top: 0.6rem;
				border-top: 1px solid var(--rule);
				font-family: var(--font-sans);
				font-style: italic;
				font-size: 14px;
				line-height: 1.48;
				color: var(--ink-soft);
			}

			/* Recent Issues 3-Column Grid */
			.desk-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.35rem;
			}

			@media (max-width: 1040px) {
				.desk {
					grid-template-columns: 1fr;
					gap: 1.75rem;
				}

				.desk-icons {
					grid-template-columns: repeat(6, minmax(0, 1fr));
					gap: 1rem;
				}
			}

			@media (max-width: 960px) {
				.crate-shelf {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}

				.desk-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}

			@media (max-width: 820px) {
				.hero {
					min-height: auto;
					padding: 5.5rem 1rem 2.5rem;
				}

				.desk-window {
					box-shadow: 6px 6px 0 rgba(12, 28, 16, 0.4);
				}

				.desk-body {
					grid-template-columns: 1fr;
				}

				.desk-art {
					border-right: none;
					border-bottom: 1.5px solid var(--d-ink);
				}

				.desk-icons {
					grid-template-columns: repeat(3, minmax(0, 1fr));
				}
			}

			@media (max-width: 600px) {
				.crate-shelf,
				.desk-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header transparent={true} />

		<section class="hero">
			<div class="hero-scene" data-us-project="iIayA4bIeBzePlqd5Bab"></div>

			{featured && (
				<div class="desk">
					<a class="desk-window" href={`/blog/${featured.id}`}>
						<span class="desk-tab">Featured</span>
						<div class="desk-titlebar" aria-hidden="true">
							<span class="desk-box"></span>
							<span class="desk-stripes"></span>
							<span class="desk-name">{categoryLabel(featured)}</span>
							<span class="desk-stripes"></span>
						</div>

						<div class="desk-body">
							<div class="desk-art">
								{featuredCat === 'nmf' ? (
									<NmfPoster
										image={featuredSpotlight}
										title={featured.data.title}
										slug={featured.id}
										dateLabel={formatShortDate(featured.data.pubDate)}
										size="hero"
									/>
								) : featured.data.heroImage ? (
									<Image src={featured.data.heroImage} alt={featured.data.title} width={960} loading="eager" />
								) : null}
							</div>

							<div class="desk-copy">
								<span class="desk-kicker">
									{categoryLabel(featured)} · <FormattedDate date={featured.data.pubDate} />
								</span>
								<h1 class="desk-title">{featured.data.title}</h1>
								<p class="desk-desc">{featured.data.description}</p>
								<div class="desk-footer-row">
									<span class="desk-open">Open →</span>
									{featuredPicks.length > 0 && (
										<div class="desk-mini-covers" aria-hidden="true">
											{featuredPicks.map(
												(p) => p.image && <Image src={p.image} alt="" width={56} height={56} />,
											)}
										</div>
									)}
								</div>
							</div>
						</div>

						<div class="desk-status" aria-hidden="true">
							<span>
								{featuredPicks.length > 0 ? `${featuredPicks.length} albums · ` : ''}
								{estimateReadTime(featured.body)} min read
							</span>
							<span>Sigil HD / Music / {featured.id}</span>
						</div>
					</a>

					<ul class="desk-icons" aria-label="Quick desktop shortcuts">
						{desktopItems.map(({ post, stack }) => (
							<li>
								<a class="desk-file" href={`/blog/${post.id}`}>
									<div class="desk-icon-stage" aria-hidden="true">
										{stack.length > 0 ? (
											<div class="img-stack">
												{stack
													.slice()
													.reverse()
													.map((img, revIdx, arr) => {
														const layer = arr.length - 1 - revIdx;
														return (
															<div class:list={['img-stack-card', `layer-${layer}`]}>
																<Image src={img} alt="" width={112} height={112} />
															</div>
														);
													})}
											</div>
										) : (
											<svg class="desk-file-svg" viewBox="0 0 44 54">
												<path
													d="M2 2h27l13 13v37H2z"
													fill="var(--d-paper)"
													stroke="var(--d-ink)"
													stroke-width="2"
													stroke-linejoin="round"
												/>
												<path d="M29 2v13h13" fill="none" stroke="var(--d-ink)" stroke-width="2" stroke-linejoin="round" />
												<path d="M17.5 40V27l10-2.5V37" fill="none" stroke="var(--d-ink)" stroke-width="2" />
												<path d="M17.5 27l10-2.5" fill="none" stroke="var(--d-ink)" stroke-width="4" />
												<circle cx="14.8" cy="40" r="3" fill="var(--d-ink)" />
												<circle cx="24.8" cy="37" r="3" fill="var(--d-ink)" />
											</svg>
										)}
									</div>
									<span class="desk-file-name">
										{post.data.title.replace(/^Favorite Albums from /, 'NMF · ')}
									</span>
								</a>
							</li>
						))}

						<li>
							<a class="desk-file" href="/crate">
								<div class="desk-icon-stage" aria-hidden="true">
									<div class="folder-stack">
										<div class="folder-back"></div>
										{crateFolderThumbs.map((img, i) => (
											<div class:list={['folder-peek', `p${i}`]}>
												<Image src={img} alt="" width={64} height={64} />
											</div>
										))}
										<div class="folder-front">CRATE</div>
									</div>
								</div>
								<span class="desk-file-name">The Crate ({allCratePicks.length})</span>
							</a>
						</li>

						<li>
							<a class="desk-file" href="/calendar">
								<div class="desk-icon-stage" aria-hidden="true">
									<div class="cal-tile-icon">
										<span class="cal-tile-head">{nextDropParts[0]}</span>
										<span class="cal-tile-num">{nextDropParts[1] ?? '•'}</span>
									</div>
								</div>
								<span class="desk-file-name">Radar ({upcoming.length})</span>
							</a>
						</li>
					</ul>
				</div>
			)}
		</section>

		<main>
			{latestNmf && latestPicks.length > 0 && (
				<section aria-label="Latest Friday crate picks">
					<div class="section-head">
						<div>
							<span class="kicker">Spinning now · {formatShortDate(latestNmf.data.pubDate)}</span>
							<h2>Inside this week’s crate</h2>
						</div>
						<a href="/crate" class="section-head-link">Dig all {allCratePicks.length} picks →</a>
					</div>
					<div class="crate-shelf">
						{latestPicks.map((pick) => (
							<a href={`/blog/${latestNmf.id}#pick-${pick.index}`} class="crate-tile">
								<div class="crate-sleeve">
									<span class="crate-num-chip">{String(pick.index).padStart(2, '0')}</span>
									{pick.image && (
										<Image src={pick.image} alt={`${pick.artist} — ${pick.album}`} width={380} height={380} />
									)}
								</div>
								<div class="crate-info">
									<span class="crate-artist">{pick.artist}</span>
									<h3 class="crate-album">{pick.album}</h3>
									{pick.tastingNote && <p class="crate-tasting">“{pick.tastingNote}”</p>}
								</div>
							</a>
						))}
					</div>
				</section>
			)}

			<section aria-label="Recent music posts">
				<div class="section-head">
					<div>
						<span class="kicker">Music Desk</span>
						<h2>Recent crates & lists</h2>
					</div>
					<a href="/blog" class="section-head-link">All {posts.length} issues →</a>
				</div>
				<div class="desk-grid">
					{recentGridPosts.map((post) => (
						<PostCard post={post} variant="grid" />
					))}
				</div>
			</section>

			<UpcomingStrip maxGroups={4} />

			<section aria-label="Newsletter subscription">
				<NewsletterStrip />
			</section>
		</main>

		<Footer />

		<script is:inline>!function(){var u=window.UnicornStudio;if(u&&u.init){if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",function(){u.init()})}else{u.init()}}else{window.UnicornStudio={isInitialized:!1};var i=document.createElement("script");i.src="https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v2.1.11/dist/unicornStudio.umd.js",i.onload=function(){if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",function(){UnicornStudio.init()})}else{UnicornStudio.init()}},(document.head||document.body).appendChild(i)}}();</script>
	</body>
</html>
