---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroLogo from '../assets/sigil-main.svg';
---

<!doctype html>
<html lang="en">
	<head>
		<style is:inline>html, body { background-color: #396e3a; }</style>
		<BaseHead title={`Page not found | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				position: relative;
				height: 100vh;
				width: 100%;
				margin-top: 0;
				background-color: #2f7039;
			}

			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				z-index: 5;
				background-image: url('/noise-sigil-white.png');
				background-repeat: repeat;
				background-size: auto;
				opacity: 0.3;
				pointer-events: none;
				mix-blend-mode: screen;
			}

			.hero-content {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				z-index: 10;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				gap: 1.25rem;
				width: min(90vw, 36rem);
				pointer-events: none;
			}

			.hero-logo {
				width: clamp(200px, 32vw, 380px);
				height: auto;
				filter: brightness(0) invert(1);
			}

			.hero-content h1 {
				margin: 0;
				color: white;
				font-size: clamp(2.5rem, 8vw, 4.5rem);
				letter-spacing: -0.04em;
				line-height: 1;
			}

			.hero-content p {
				margin: 0;
				color: rgba(255, 255, 255, 0.9);
				font-size: 1.1rem;
				max-width: 28ch;
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				justify-content: center;
				pointer-events: auto;
				margin-top: 0.5rem;
			}

			.hero-actions a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.75rem 1.25rem;
				border-radius: 4px;
				font-weight: 600;
				text-decoration: none;
				transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
			}

			.hero-actions .btn-primary {
				background: white;
				color: var(--green);
				border: 2px solid white;
			}

			.hero-actions .btn-primary:hover {
				background: rgba(255, 255, 255, 0.9);
			}

			.hero-actions .btn-secondary {
				background: transparent;
				color: white;
				border: 2px solid rgba(255, 255, 255, 0.7);
			}

			.hero-actions .btn-secondary:hover {
				border-color: white;
				background: rgba(255, 255, 255, 0.12);
			}
		</style>
	</head>
	<body>
		<Header transparent={true} />

		<section class="hero">
			<div data-us-project="iIayA4bIeBzePlqd5Bab" style="width: 100%; height: 100vh; background-color: #4f7040;"></div>
			<div class="hero-content">
				<img src={heroLogo.src} alt={SITE_TITLE} class="hero-logo" />
				<h1>404</h1>
				<p>This page wandered off. Head home or browse the work.</p>
				<div class="hero-actions">
					<a href="/" class="btn-primary">Back home</a>
					<a href="/portfolio" class="btn-secondary">See our work</a>
				</div>
			</div>
		</section>

		<Footer />

		<script is:inline>!function(){var u=window.UnicornStudio;if(u&&u.init){if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",function(){u.init()})}else{u.init()}}else{window.UnicornStudio={isInitialized:!1};var i=document.createElement("script");i.src="https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v2.1.11/dist/unicornStudio.umd.js",i.onload=function(){if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",function(){UnicornStudio.init()})}else{UnicornStudio.init()}},(document.head||document.body).appendChild(i)}}();</script>
	</body>
</html>
