---
// A list of "In the news" stories: source, headline (opens the other site in a new tab), date,
// the Sigil artists it is about and, when written, a one-line Sigil take. No images: those
// belong to the other sites.
import type { Story } from '../lib/news';

interface Props {
	stories: Story[];
	/** Leave out the artist links, e.g. on that artist's own page. */
	hideArtists?: boolean;
}

const { stories, hideArtists = false } = Astro.props;
const date = (d: Date) => d.toLocaleDateString('en-us', { month: 'short', day: 'numeric' });
---

<ul class="news-list">
	{stories.map((s) => (
		<li class="news-item">
			<div class="news-meta">
				<span class="news-source">{s.source}</span>
				<time datetime={s.date.toISOString()}>{date(s.date)}</time>
			</div>
			<a class="news-title" href={s.url} target="_blank" rel="noopener noreferrer">
				{s.title}
				<span class="news-out" aria-hidden="true"> ↗</span>
				<span class="sr-only">(opens {s.source} in a new tab)</span>
			</a>
			{s.take && <p class="news-take">{s.take}</p>}
			{!hideArtists && (
				<div class="news-artists">
					{s.artists.map((a) => (a.href ? <a href={a.href}>{a.name}</a> : <span>{a.name}</span>))}
				</div>
			)}
		</li>
	))}
</ul>

<style>
	.news-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
		gap: 1.15rem;
	}

	.news-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.15rem 1.25rem;
		background: var(--paper-card);
		border-radius: 7px;
		box-shadow: var(--shadow-card);
		transition:
			transform var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.news-item:hover {
			transform: translateY(-2px);
			box-shadow: var(--shadow-card-hover);
			transition-duration: var(--dur-fast);
		}
	}

	.news-item:active {
		transform: scale(0.99);
		transition-duration: var(--dur-press);
	}

	.news-meta {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gray);
		font-variant-numeric: tabular-nums;
	}

	.news-source {
		color: var(--green);
	}

	.news-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.08rem;
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-decoration: none;
		text-wrap: balance;
		transition: color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.news-title:hover {
			color: var(--green-dark);
		}
	}

	.news-out {
		color: var(--green);
		font-family: var(--font-mono);
		font-size: 0.8em;
	}

	.news-take {
		margin: 0;
		font-size: 14.5px;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.news-artists {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: auto;
		padding-top: 0.4rem;
	}

	.news-artists > * {
		padding: 0.16rem 0.55rem;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--green);
		background: var(--green-tint);
		text-decoration: none;
		transition:
			transform var(--dur-press) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.news-artists a:hover {
			background: var(--green);
			border-color: var(--green);
			color: var(--white);
		}
	}

	.news-artists a:active {
		transform: scale(0.95);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
