---
// A list of "In the news" stories: source, headline (opens the other site in a new tab), date,
// the Sigil artists it is about and, when written, a one-line Sigil take. No images: those
// belong to the other sites.
import type { Story } from '../lib/news';

interface Props {
	stories: Story[];
	/** Leave out the artist links, e.g. on that artist's own page. */
	hideArtists?: boolean;
}

const { stories, hideArtists = false } = Astro.props;
const date = (d: Date) => d.toLocaleDateString('en-us', { month: 'short', day: 'numeric', year: 'numeric' });
---

<ul class="news-list">
	{stories.map((s) => (
		<li class="news-item">
			<div class="news-meta">
				<span class="news-source">{s.source}</span>
				<time datetime={s.date.toISOString()}>{date(s.date)}</time>
			</div>
			<a class="news-title" href={s.url} target="_blank" rel="noopener">
				{s.title}
				<span class="news-out" aria-hidden="true">↗</span>
				<span class="sr-only">(opens {s.source} in a new tab)</span>
			</a>
			{s.take && <p class="news-take">{s.take}</p>}
			{!hideArtists && (
				<div class="news-artists">
					{s.artists.map((a) => (a.href ? <a href={a.href}>{a.name}</a> : <span>{a.name}</span>))}
				</div>
			)}
		</li>
	))}
</ul>

<style>
	.news-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
	}
	.news-item {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.1rem 1.2rem;
		border: 2px solid var(--green);
		border-radius: 8px;
	}
	.news-meta {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--gray);
	}
	.news-source {
		color: var(--green);
	}
	.news-title {
		font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-weight: 700;
		font-size: 1.05rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--black);
		text-decoration: none;
	}
	.news-title:hover {
		text-decoration: underline;
	}
	.news-out {
		color: var(--green);
		font-size: 0.85em;
	}
	.news-take {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.45;
		font-style: italic;
	}
	.news-artists {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: auto;
		padding-top: 0.3rem;
	}
	.news-artists > * {
		padding: 0.15rem 0.55rem;
		border: 1.5px solid var(--green);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--green);
		text-decoration: none;
	}
	.news-artists a:hover {
		background: var(--green);
		color: var(--cream);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
