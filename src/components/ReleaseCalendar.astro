---
// Two lists side by side:
// - "Out this month": every album on the release calendar (src/lib/calendar.ts) released this
//   month, best fit for Brandon's taste first. This month and next are both rendered and the
//   script picks by today's date, so the list turns over on the 1st without a rebuild. The first
//   12 show; the rest are behind "Show all".
// - "Anticipated": albums flagged in the crate's "Coming up", from src/data/releases.json. Each
//   shows until its release day. Albums in the current "Upcoming albums" grid stay out of it
//   while that grid is showing.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import releases from '../data/releases.json';
import upcoming from '../data/upcoming.json';
import { byTaste, currentMonths, getCalendar, monthId, monthName } from '../lib/calendar';

const SHOW = 12;
const calendar = await getCalendar();
const months = currentMonths().map((month) => ({ month, name: monthName(month).split(' ')[0], albums: byTaste(calendar, month) }));

const covers = import.meta.glob<ImageMetadata>('/src/assets/releases/*.{jpg,jpeg,png,webp}', {
	eager: true,
	import: 'default',
});

const inGrid = new Set(upcoming.albums.map((a) => a.id));
const albums = releases.albums.map((album) => {
	const [y, m, d] = album.releaseDate.split('-').map(Number);
	return {
		...album,
		// "Dec 5", or just "Dec" when only the month is known.
		label: new Date(y, m - 1, d || 1).toLocaleDateString(
			'en-US',
			d ? { month: 'short', day: 'numeric' } : { month: 'short' },
		),
		image: album.cover ? covers[`/src/assets/releases/${album.cover}`] : undefined,
		grid: inGrid.has(album.id),
	};
});

---

<section class="calendar" data-calendar data-grid-friday={upcoming.friday} hidden>
	{months.map(({ month, name, albums: list }) => (
		<div class="calendar-col" data-calendar-col="out" data-month={month} hidden>
			<div class="calendar-head">
				<h2>Out this month</h2>
				<a href={`/releases#${monthId(month)}`}>Full calendar →</a>
			</div>
			<p class="calendar-note">
				Everything out in {name}, {list.length} albums, best fit first.
				<span class="calendar-key"><b>88</b> crate score · <i>~60</i> estimate</span>
			</p>
			<ol class="calendar-list" data-out-list>
				{list.map((album, i) => (
					<li data-extra={i >= SHOW ? '' : undefined} hidden={i >= SHOW}>
						<a class="calendar-row has-score" href={album.listen} target="_blank" rel="noopener">
							<time class="calendar-date" datetime={album.releaseDate}>{album.dateLabel}</time>
							<span class="calendar-thumb" aria-hidden="true">
								{album.cover ? <Image src={album.cover} alt="" width={96} height={96} /> : album.artist.trim().charAt(0).toUpperCase()}
							</span>
							<span class="calendar-text">
								<strong>{album.artist}</strong>
								<span>{album.title}</span>
							</span>
							<span class:list={['calendar-score', { estimated: album.estimated }]} title={album.estimated ? 'Estimated fit' : 'Crate fit score'}>
								{album.estimated ? `~${album.score}` : album.score}
							</span>
						</a>
					</li>
				))}
			</ol>
			{list.length > SHOW && (
				<button type="button" class="calendar-more" data-show-all aria-expanded="false">
					Show all {list.length}
				</button>
			)}
		</div>
	))}
	<div class="calendar-col" data-calendar-col="ahead" hidden>
		<div class="calendar-head">
			<h2>Anticipated</h2>
			<a href="/releases">Full calendar →</a>
		</div>
		<ol class="calendar-list">
			{albums.map((album) => {
				const Tag = album.listen ? 'a' : 'div';
				const linkProps = album.listen ? { href: album.listen, target: '_blank', rel: 'noopener' } : {};
				return (
					<li data-date={album.releaseDate} data-grid={album.grid ? '' : undefined} hidden>
						<Tag class="calendar-row" {...linkProps}>
							<time class="calendar-date" datetime={album.releaseDate}>
								{album.label}
							</time>
							<span class="calendar-thumb" aria-hidden="true">
								{album.image ? <Image src={album.image} alt="" width={96} height={96} /> : album.artist.trim().charAt(0).toUpperCase()}
							</span>
							<span class="calendar-text">
								<strong>{album.artist}</strong>
								<span>{album.title}</span>
							</span>
						</Tag>
					</li>
				);
			})}
		</ol>
	</div>
</section>

<style>
	.calendar {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 2.5rem 3rem;
		margin-bottom: 3.5rem;
	}

	.calendar[hidden],
	.calendar-col[hidden],
	.calendar-list li[hidden] {
		display: none;
	}

	.calendar-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin: 0 0 0.4rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid var(--green);
	}

	.calendar-head h2 {
		margin: 0;
	}

	.calendar-head a {
		font-size: 0.9rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.calendar-note {
		margin: 0.6rem 0 0.2rem;
		font-size: 0.85rem;
		color: var(--gray);
	}

	.calendar-key {
		display: inline-block;
		margin-left: 0.4rem;
	}

	.calendar-key b,
	.calendar-key i {
		font-style: normal;
		font-weight: 700;
		color: var(--green);
	}

	/* With "Anticipated" empty, "Out this month" has the full width: two columns of rows. */
	.calendar:not(:has([data-calendar-col='ahead']:not([hidden]))) [data-out-list] {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
		column-gap: 3rem;
	}

	.calendar-row.has-score {
		grid-template-columns: 3.6rem 44px minmax(0, 1fr) auto;
	}

	.calendar-score {
		min-width: 2.4rem;
		padding: 0.15rem 0.4rem;
		border: 2px solid var(--green);
		border-radius: 999px;
		background: var(--green);
		color: var(--cream);
		font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
		font-size: 0.78rem;
		font-weight: 700;
		text-align: center;
	}

	.calendar-score.estimated {
		background: transparent;
		color: var(--green);
		border-style: dashed;
	}

	.calendar-more {
		margin-top: 1rem;
		padding: 0.45rem 1rem;
		border: 2px solid var(--green);
		border-radius: 999px;
		background: transparent;
		color: var(--green);
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
	}

	.calendar-more:hover {
		background: var(--green);
		color: var(--cream);
	}

	.calendar-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.calendar-row {
		display: grid;
		grid-template-columns: 3.6rem 44px minmax(0, 1fr);
		align-items: center;
		gap: 0.9rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--green) 30%, transparent);
		color: inherit;
		text-decoration: none;
	}

	.calendar-date {
		font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--green);
	}

	.calendar-thumb {
		width: 44px;
		height: 44px;
		border: 2px solid var(--green);
		border-radius: 6px;
		overflow: hidden;
		/* With no cover, a green tile with the artist's initial, like the stand-in sleeves in the grid. */
		display: grid;
		place-items: center;
		background: #417039;
		color: #f6f5ef;
		font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1;
	}

	.calendar-thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.calendar-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.3;
	}

	.calendar-text strong {
		font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-weight: 700;
		letter-spacing: -0.01em;
		transition: color 0.2s ease;
	}

	.calendar-text span {
		font-size: 0.92rem;
		color: var(--gray);
	}

	.calendar-text strong,
	.calendar-text span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	a.calendar-row:hover strong {
		color: var(--green-dark);
	}
</style>

<script>
	// Decide, from today's date, which list each album belongs in.
	const DAY = 86400000;
	const GRID_DAYS = 14; // how long the "Upcoming albums" grid shows a week (see UpcomingAlbums.astro)
	const calendar = document.querySelector<HTMLElement>('[data-calendar]');

	if (calendar) {
		const now = new Date();
		const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
		const [gy, gm, gd] = (calendar.dataset.gridFriday ?? '').split('-').map(Number);
		const gridShowing = gy ? (today.getTime() - new Date(gy, gm - 1, gd).getTime()) / DAY < GRID_DAYS : false;

		// "Anticipated": albums not out yet, minus the ones in the "Upcoming albums" grid.
		const ahead = (item: HTMLElement) => {
			if (gridShowing && item.dataset.grid !== undefined) return false;
			const [y, m, d] = (item.dataset.date ?? '').split('-').map(Number);
			if (!y || !m) return false;
			// With only a month known, the album counts as still to come until that month is over.
			return (d ? new Date(y, m - 1, d) : new Date(y, m, 0)) > today;
		};
		const thisMonth = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`;

		let any = false;
		calendar.querySelectorAll<HTMLElement>('[data-calendar-col]').forEach((col) => {
			let shown = 0;
			if (col.dataset.calendarCol === 'out') {
				shown = col.dataset.month === thisMonth ? col.querySelectorAll('li').length : 0;
			} else {
				col.querySelectorAll<HTMLElement>('li').forEach((item) => {
					item.hidden = !ahead(item);
					if (!item.hidden) shown++;
				});
			}
			col.hidden = shown === 0;
			if (shown) any = true;
		});

		calendar.querySelectorAll<HTMLButtonElement>('[data-show-all]').forEach((button) => {
			button.addEventListener('click', () => {
				const open = button.getAttribute('aria-expanded') !== 'true';
				button.closest('[data-calendar-col]')?.querySelectorAll<HTMLElement>('[data-extra]').forEach((li) => (li.hidden = !open));
				button.setAttribute('aria-expanded', String(open));
				button.textContent = open ? 'Show fewer' : `Show all ${button.closest('[data-calendar-col]')?.querySelectorAll('li').length}`;
			});
		});
		calendar.hidden = !any;
	}
</script>
