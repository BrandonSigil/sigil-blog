---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import FallbackImage from '../assets/about/sigil-couple.jpg';
import { SITE_STUDIO, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	ogImageUrl?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	ogImageUrl,
	type = 'website',
	publishedTime,
	modifiedTime,
	structuredData,
	noindex = false,
} = Astro.props;

const ogImageSrc =
	ogImageUrl ?? (await getImage({ src: image, width: 1200, height: 630, format: 'jpeg' })).src;
const ogDescription = description.length > 155 ? description.slice(0, 152) + '...' : description;
const jsonLd = structuredData
	? Array.isArray(structuredData)
		? structuredData
		: [structuredData]
	: null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} — Music News & Reviews`}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Technical Hardware-Meets-Software Typography: Space Grotesk + IBM Plex Sans + IBM Plex Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@500;600;700&display=swap"
/>

{noindex && <meta name="robots" content="noindex" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={SITE_STUDIO} />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={new URL(ogImageSrc, Astro.url)} />
{type === 'article' && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={ogDescription} />
<meta property="twitter:image" content={new URL(ogImageSrc, Astro.url)} />

{jsonLd &&
	jsonLd.map((data) => (
		<script type="application/ld+json" set:html={JSON.stringify(data)} />
	))}

<!-- Analytics -->
<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="a76fb39b-72b5-4044-9cb3-452e8a4f49d1"></script>

<!-- Fluid interruptible shared-element highlights (nav pills & ledger rows) -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
		if (!finePointer) return;

		// 1. Sliding pill highlight for horizontal nav & filter groups
		document.querySelectorAll('[data-glide-group]').forEach((group) => {
			const pill = document.createElement('span');
			pill.className = 'glide-pill';
			pill.setAttribute('aria-hidden', 'true');
			group.prepend(pill);

			let hasMoved = false;
			const moveTo = (el) => {
				const gr = group.getBoundingClientRect();
				const r = el.getBoundingClientRect();
				const x = r.left - gr.left + group.scrollLeft;
				const y = r.top - gr.top + group.scrollTop;
				if (!hasMoved) {
					pill.style.transition = 'opacity 150ms cubic-bezier(0.23, 1, 0.32, 1)';
				} else {
					pill.style.transition = '';
				}
				pill.style.width = `${r.width}px`;
				pill.style.height = `${r.height}px`;
				pill.style.transform = `translate3d(${x}px, ${y}px, 0)`;
				pill.style.opacity = '1';
				requestAnimationFrame(() => {
					hasMoved = true;
				});
			};

			group.querySelectorAll('a, button').forEach((item) => {
				item.addEventListener('mouseenter', () => moveTo(item));
				item.addEventListener('focus', () => moveTo(item));
			});

			group.addEventListener('mouseleave', () => {
				pill.style.opacity = '0';
				hasMoved = false;
			});
		});

		// 2. Sliding row backdrop for stacked release ledgers
		document.querySelectorAll('[data-glide-list]').forEach((list) => {
			const bg = document.createElement('span');
			bg.className = 'glide-row-bg';
			bg.setAttribute('aria-hidden', 'true');
			list.prepend(bg);

			let hasMoved = false;
			const moveToRow = (row) => {
				const lr = list.getBoundingClientRect();
				const r = row.getBoundingClientRect();
				const x = r.left - lr.left;
				const y = r.top - lr.top;
				if (!hasMoved) {
					bg.style.transition = 'opacity 150ms cubic-bezier(0.23, 1, 0.32, 1)';
				} else {
					bg.style.transition = '';
				}
				bg.style.width = `${r.width}px`;
				bg.style.height = `${r.height}px`;
				bg.style.transform = `translate3d(${x}px, ${y}px, 0)`;
				bg.style.opacity = '1';
				requestAnimationFrame(() => {
					hasMoved = true;
				});
			};

			list.querySelectorAll('[data-glide-row]').forEach((row) => {
				row.addEventListener('mouseenter', () => moveToRow(row));
			});

			list.addEventListener('mouseleave', () => {
				bg.style.opacity = '0';
				hasMoved = false;
			});
		});
	});
</script>
