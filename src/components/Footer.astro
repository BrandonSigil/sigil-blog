---
import logoSrc from '../assets/sigil-main.svg';
import { SIGIL_PLAYLIST_URL, SITE_LOCATION, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<a href="/" class="footer-logo">
				<img src={logoSrc.src} alt={SITE_TITLE} />
			</a>
			<p class="footer-colophon">
				Weekly New Music Friday picks, album reviews, and a live release calendar out of {SITE_LOCATION}.
			</p>
		</div>

		<div class="footer-col">
			<h4>Explore</h4>
			<ul>
				<li><a href="/blog">Issues</a></li>
				<li><a href="/albums">Album Index</a></li>
				<li><a href="/artists">Artists</a></li>
				<li><a href="/genres">Genres</a></li>
				{/* <li><a href="/news">In the News</a></li> */}
			</ul>
		</div>

		<div class="footer-col">
			<h4>Calendar & Feeds</h4>
			<ul>
				<li><a href="/calendar">Release Calendar</a></li>
				<li><a href="/releases.ics">Calendar Feed (.ics)</a></li>
				<li><a href="/rss.xml">RSS Feed</a></li>
				<li>
					<a href={SIGIL_PLAYLIST_URL} target="_blank" rel="noopener noreferrer">Sigil Picks on Spotify ↗</a>
				</li>
				<li><a href="/search">Search</a></li>
				<li><a href="/about">About</a></li>
			</ul>
		</div>
	</div>

	<div class="footer-bottom">
		<p>&copy; {today.getFullYear()} {SITE_TITLE.toUpperCase()}. All rights reserved.</p>
		<p class="footer-note">{SITE_LOCATION}</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--green);
		margin-top: 5.5rem;
		padding: 3.5rem 1.5rem 2rem;
		background: var(--paper-card);
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.85fr) minmax(0, 0.85fr);
		gap: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.footer-logo {
		display: inline-block;
		margin-bottom: 1rem;
	}

	.footer-logo img {
		height: 2rem;
		width: auto;
	}

	.footer-colophon {
		margin: 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 40ch;
	}

	.footer-col h4 {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.13em;
		color: var(--green);
		margin: 0 0 1rem;
	}

	.footer-col ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer-col li {
		margin: 0;
	}

	.footer-col a {
		color: var(--ink);
		font-size: 15px;
		font-weight: 400;
	}

	.footer-col a:hover {
		color: var(--green);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.footer-bottom {
		max-width: 1200px;
		margin: 1.5rem auto 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--gray);
		letter-spacing: 0.04em;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 768px) {
		footer {
			padding: 2.5rem 1rem 1.75rem;
		}

		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
