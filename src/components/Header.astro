---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import logoSrc from '../assets/sigil-main.svg';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
	transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={[{ transparent }]}>
	<SpeedInsights />
	<nav aria-label="Primary navigation">
		<a href="/" class="logo">
			<img src={logoSrc.src} alt={SITE_TITLE} />
		</a>
		<div class="nav-links">
			<HeaderLink href="/blog">Music</HeaderLink>
			<HeaderLink href="/crate">Crate</HeaderLink>
			<HeaderLink href="/calendar">Calendar</HeaderLink>
			<span class="nav-divider" aria-hidden="true"></span>
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		z-index: 100;
		background: rgba(247, 246, 241, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition: background 0.35s ease, backdrop-filter 0.35s ease;
		--link-color: var(--ink);
		--link-hover-bg: var(--green-tint);
		--link-hover-color: var(--green);
		--link-active-color: var(--green);
	}

	header.transparent {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		--link-color: rgba(255, 255, 255, 0.92);
		--link-hover-bg: rgba(255, 255, 255, 0.14);
		--link-hover-color: #ffffff;
		--link-active-color: #ffffff;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.9rem 1.5rem;
		border-bottom: 1px solid var(--rule-green);
		transition: border-color 0.35s ease;
		gap: 1rem;
	}

	header.transparent nav {
		border-bottom-color: rgba(255, 255, 255, 0.2);
	}

	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
	}

	.logo img {
		height: 2.2rem;
		width: auto;
		transition: filter 0.35s ease;
	}

	header.transparent .logo img {
		filter: brightness(0) invert(1);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}

	.nav-divider {
		width: 1px;
		height: 1rem;
		background: var(--rule-strong);
		margin: 0 0.35rem;
		transition: background 0.35s ease;
	}

	header.transparent .nav-divider {
		background: rgba(255, 255, 255, 0.3);
	}

	@media (max-width: 768px) {
		nav {
			padding: 0.75rem 1rem;
		}

		.logo img {
			height: 1.75rem;
		}

		.nav-links {
			gap: 0.05rem;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.nav-links::-webkit-scrollbar {
			display: none;
		}

		.nav-divider {
			margin: 0 0.2rem;
		}
	}
</style>

<script>
	const header = document.querySelector('header') as HTMLElement | null;
	const hero = document.querySelector('.hero') as HTMLElement | null;

	if (header && hero) {
		document.body.classList.add('has-hero');

		const update = () => {
			header.classList.toggle('transparent', hero.getBoundingClientRect().bottom > 64);
		};

		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>
