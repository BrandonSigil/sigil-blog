---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import logoSrc from '../assets/sigil-main.svg';
import  SpeedInsights  from "@vercel/speed-insights/astro"
import { getLiveSections } from '../lib/posts';

// One link per section that has posts, then About. A section with nothing published yet
// stays out of the nav until its first post goes live.
const sections = await getLiveSections();

interface Props {
	transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={[{ transparent }]}>
	<SpeedInsights />
	<nav>
		<a href="/" class="logo">
			<img src={logoSrc.src} alt={SITE_TITLE} width={logoSrc.width} height={logoSrc.height} />
		</a>
		<div class="nav-links">
			{sections.map((section) => <HeaderLink href={`/${section.slug}`}>{section.label}</HeaderLink>)}
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/search" class="nav-search" aria-label="Search">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
					<circle cx="11" cy="11" r="6.5" />
					<path d="M16 16l4.5 4.5" />
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		z-index: 100;
		background: rgba(247, 246, 241, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition: background 0.4s ease, backdrop-filter 0.4s ease;
		--link-color: var(--green);
		--link-hover-bg: var(--gray-lighter);
		--link-hover-color: var(--green);
		--link-active-color: var(--green);
	}

	header.transparent {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		--link-color: white;
		--link-hover-bg: rgba(255, 255, 255, 0.15);
		--link-hover-color: white;
		--link-active-color: white;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		border-bottom: 2px solid var(--green);
		transition: border-color 0.4s ease;
	}

	header.transparent nav {
		border-bottom-color: transparent;
	}

	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.logo img {
		height: 2.5rem;
		width: auto;
		transition: filter 0.4s ease;
	}

	header.transparent .logo img {
		filter: brightness(0) invert(1);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-search {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 4px;
		color: var(--link-color, var(--green));
		transition: color 0.4s ease, background 0.4s ease;
	}

	.nav-search:hover {
		background: var(--link-hover-bg, var(--gray-lighter));
	}

	@media (max-width: 768px) {
		nav {
			padding: 1rem;
		}

		.logo img {
			height: 2rem;
		}

		.nav-links {
			gap: 0;
		}

		.nav-links :global(a) {
			padding: 0.4rem 0.5rem;
			font-size: 0.92rem;
		}

		.nav-search {
			width: 2rem;
			height: 2rem;
		}
	}

	/* Narrow phones: the links need the room, and search is also in the footer */
	@media (max-width: 420px) {
		.nav-search {
			display: none;
		}
	}
</style>

<script>
	const header = document.querySelector('header') as HTMLElement;
	const hero = document.querySelector('.hero') as HTMLElement | null;

	if (hero) {
		document.body.classList.add('has-hero');

		const update = () => {
			// Stay see-through only while the hero is still behind the nav bar itself.
			header.classList.toggle('transparent', hero.getBoundingClientRect().bottom > header.offsetHeight / 2);
		};

		window.addEventListener('scroll', update, { passive: true });
	}
</script>
