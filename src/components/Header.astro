---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import logoSrc from '../assets/sigil-main.svg';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
	transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class:list={[{ transparent }]}>
	<SpeedInsights />
	<nav aria-label="Primary navigation">
		<a href="/" class="logo">
			<img src={logoSrc.src} alt={SITE_TITLE} width={logoSrc.width} height={logoSrc.height} />
		</a>
		<div class="nav-links" data-glide-group>
			<HeaderLink href="/blog">Issues</HeaderLink>
			<HeaderLink href="/albums">Index</HeaderLink>
			<HeaderLink href="/calendar">Calendar</HeaderLink>
			{/* <HeaderLink href="/news">News</HeaderLink> */}
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/search" class="nav-search" aria-label="Search">
				<svg
					viewBox="0 0 24 24"
					width="17"
					height="17"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="6.5" />
					<path d="M16 16l4.5 4.5" />
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		z-index: 100;
		background: rgba(247, 246, 241, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition: background 0.35s ease, backdrop-filter 0.35s ease;
		--link-color: var(--ink);
		--link-hover-bg: transparent;
		--link-hover-color: var(--green-dark);
		--link-active-color: var(--green);
		--glide-bg: var(--green-tint);
	}

	header.transparent {
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		--link-color: rgba(255, 255, 255, 0.9);
		--link-hover-bg: transparent;
		--link-hover-color: #ffffff;
		--link-active-color: #ffffff;
		--glide-bg: rgba(255, 255, 255, 0.14);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.9rem 1.5rem;
		border-bottom: 1px solid var(--rule-green);
		transition: border-color 0.35s ease;
		gap: 1rem;
	}

	header.transparent nav {
		border-bottom-color: rgba(255, 255, 255, 0.2);
	}

	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
	}

	.logo img {
		height: 2.2rem;
		width: auto;
		transition: filter 0.35s ease;
	}

	header.transparent .logo img {
		filter: brightness(0) invert(1);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}

	.nav-search {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 5px;
		color: var(--link-color, var(--ink));
		transition:
			color var(--dur-fast) var(--ease-out),
			transform var(--dur-press) var(--ease-out);
	}

	.nav-search:hover {
		color: var(--link-hover-color, var(--green-dark));
	}

	.nav-search:active {
		transform: scale(0.94);
	}

	@media (max-width: 768px) {
		nav {
			padding: 0.75rem 1rem;
		}

		.logo img {
			height: 1.75rem;
		}

		.nav-links {
			gap: 0.05rem;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.nav-links::-webkit-scrollbar {
			display: none;
		}
	}

	@media (max-width: 420px) {
		.nav-search {
			display: none;
		}
	}
</style>

<script>
	const header = document.querySelector('header') as HTMLElement | null;
	const hero = document.querySelector('.hero') as HTMLElement | null;

	if (header && hero) {
		document.body.classList.add('has-hero');

		const update = () => {
			header.classList.toggle('transparent', hero.getBoundingClientRect().bottom > header.offsetHeight / 2);
		};

		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>
