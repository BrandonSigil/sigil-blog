---
// A grid of album picks for the hub pages, matching Sigil's hairline green sleeve cards.
import { Image } from 'astro:assets';
import type { AlbumPick } from '../lib/albums';
import { MONTHS } from '../lib/hubs';

interface Props {
	picks: AlbumPick[];
	/** What the small line under each album shows. */
	detail?: 'date' | 'genre' | 'none';
	eager?: number;
}

const { picks, detail = 'date', eager = 8 } = Astro.props;
const label = (p: AlbumPick) =>
	detail === 'date'
		? `${MONTHS[p.pubDate.getMonth()].slice(0, 3)} ${p.pubDate.getDate()}, ${p.pubDate.getFullYear()}`
		: detail === 'genre'
			? (p.genre?.name ?? '')
			: '';
---

<ul class="album-grid">
	{picks.map((pick, i) => (
		<li>
			<a class="album" href={pick.href}>
				<div class="album-sleeve">
					{pick.cover && (
						<Image
							src={pick.cover}
							alt={`${pick.album} by ${pick.artist}`}
							width={340}
							height={340}
							loading={i < eager ? 'eager' : 'lazy'}
						/>
					)}
				</div>
				<span class="album-artist">{pick.artist}</span>
				<span class="album-title">{pick.album}</span>
				{label(pick) && <span class="album-detail">{label(pick)}</span>}
			</a>
		</li>
	))}
</ul>

<style>
	.album-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
		gap: 1.85rem 1.25rem;
	}

	.album {
		display: flex;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
		transition: transform var(--dur-press) var(--ease-out);
	}

	.album:active {
		transform: scale(0.985);
	}

	.album-sleeve {
		aspect-ratio: 1;
		margin-bottom: 0.7rem;
		border-radius: 7px;
		overflow: hidden;
		background: var(--gray-lighter);
		box-shadow: var(--shadow-card);
		transition:
			transform var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.album:hover .album-sleeve,
		.album:focus-visible .album-sleeve {
			transform: translateY(-2px);
			box-shadow: var(--shadow-card-hover);
			transition-duration: var(--dur-fast);
		}

		.album:hover .album-sleeve :global(img) {
			transform: scale(1.03);
			transition-duration: var(--dur-fast);
		}
	}

	.album-sleeve :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.album-artist {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--ink);
		transition: color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.album:hover .album-artist {
			color: var(--green);
		}
	}

	.album-title {
		font-size: 14px;
		line-height: 1.35;
		color: var(--ink-soft);
	}

	.album-detail {
		margin-top: 0.3rem;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--green);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 480px) {
		.album-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
