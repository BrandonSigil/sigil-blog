---
interface Props {
	spotifyUrl: string;
	youtubeUrl: string;
	bandcampUrl: string;
	appleMusicUrl: string;
	labelPrefix?: string;
	compact?: boolean;
}

const {
	spotifyUrl,
	youtubeUrl,
	bandcampUrl,
	appleMusicUrl,
	labelPrefix = 'Listen',
	compact = false,
} = Astro.props;
---

<div class:list={['listen-icons', { compact }]}>
	<a
		href={spotifyUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="listen-icon-btn is-spotify"
		title="Spotify"
		aria-label={`${labelPrefix} on Spotify`}
		data-umami-event="listen-spotify"
		data-umami-event-album={labelPrefix}
	>
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.58 14.42a.62.62 0 0 1-.86.2c-2.36-1.44-5.33-1.76-8.83-.96a.62.62 0 1 1-.28-1.22c3.83-.87 7.12-.5 9.77 1.12.3.18.39.56.2.86zm1.22-2.72a.78.78 0 0 1-1.07.26c-2.7-1.66-6.82-2.14-10.02-1.17a.78.78 0 0 1-.46-1.49c3.65-1.11 8.19-.57 11.29 1.33.37.23.49.71.26 1.07zm.11-2.83C14.67 8.95 9.33 8.77 6.24 9.71a.94.94 0 1 1-.55-1.8c3.55-1.08 9.45-.87 13.19 1.35a.94.94 0 0 1-.97 1.61z" />
		</svg>
	</a>

	<a
		href={youtubeUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="listen-icon-btn is-youtube"
		title="YouTube"
		aria-label={`${labelPrefix} on YouTube`}
		data-umami-event="listen-youtube"
		data-umami-event-album={labelPrefix}
	>
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M21.58 7.19a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.82.42a2.5 2.5 0 0 0-1.76 1.77C2 8.77 2 12 2 12s0 3.23.42 4.81a2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.82-.42a2.5 2.5 0 0 0 1.76-1.77C22 15.23 22 12 22 12s0-3.23-.42-4.81zM10 15V9l5.2 3-5.2 3z" />
		</svg>
	</a>

	<a
		href={bandcampUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="listen-icon-btn is-bandcamp"
		title="Bandcamp"
		aria-label={`${labelPrefix} on Bandcamp`}
		data-umami-event="listen-bandcamp"
		data-umami-event-album={labelPrefix}
	>
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M2 17.5 8.5 6.5H22l-6.5 11H2z" />
		</svg>
	</a>

	<a
		href={appleMusicUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="listen-icon-btn is-apple"
		title="Apple Music"
		aria-label={`${labelPrefix} on Apple Music`}
		data-umami-event="listen-apple"
		data-umami-event-album={labelPrefix}
	>
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M18.5 4.1 9.5 6.2v9.65a2.75 2.75 0 1 1-1.5-2.45V5.1a.9.9 0 0 1 .7-.88l10-2.3A.85.85 0 0 1 19.8 2.75v11.1a2.75 2.75 0 1 1-1.5-2.45V4.1z" />
		</svg>
	</a>
</div>

<style>
	.listen-icons {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.listen-icon-btn {
		display: inline-grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 5px;
		border: 1px solid var(--rule-strong);
		background: var(--paper-card);
		color: var(--ink-soft);
		transition:
			transform var(--dur-press) var(--ease-out),
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}

	.listen-icons.compact .listen-icon-btn {
		width: 26px;
		height: 26px;
		border-color: var(--rule);
	}

	.listen-icon-btn svg {
		width: 14px;
		height: 14px;
		display: block;
	}

	.listen-icons.compact .listen-icon-btn svg {
		width: 13px;
		height: 13px;
	}

	@media (hover: hover) and (pointer: fine) {
		.listen-icon-btn:hover {
			color: #f7f6f1;
			border-color: var(--green);
			background: var(--green);
		}
	}

	.listen-icon-btn:active {
		transform: scale(0.92);
	}
</style>
