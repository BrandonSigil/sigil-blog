---
interface Props {
	note: string;
	compact?: boolean;
	tilt?: boolean;
}

const { note, compact = false, tilt = false } = Astro.props;
---

<div class:list={['hype-note', { compact, tilt }]}>
	<div class="hype-note-bar">
		<span class="hype-note-kicker">
			<svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
				<circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.3" />
				<circle cx="6" cy="6" r="1.5" fill="currentColor" />
			</svg>
			Tasting Notes
		</span>
		<span class="hype-note-dots" aria-hidden="true">•••</span>
	</div>
	<p class="hype-note-quote">“{note}”</p>
</div>

<style>
	.hype-note {
		background: var(--paper-card);
		border: 1px solid var(--green);
		border-radius: 5px;
		box-shadow: 0 2px 6px -1px rgba(36, 74, 35, 0.08), 3px 3px 0 rgba(62, 125, 60, 0.2);
		margin: 0.9rem 0 1.25rem;
		overflow: hidden;
		transition:
			transform var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	.hype-note.tilt {
		transform: rotate(-0.35deg);
	}

	@media (hover: hover) and (pointer: fine) {
		.hype-note.tilt:hover {
			transform: rotate(0deg);
			box-shadow: 0 4px 12px -2px rgba(36, 74, 35, 0.12), 4px 4px 0 rgba(62, 125, 60, 0.26);
		}
	}

	.hype-note-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.28rem 0.75rem;
		background: var(--green);
		color: #f7f6f1;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.hype-note-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: #f7f6f1;
	}

	.hype-note-dots {
		opacity: 0.65;
		letter-spacing: 0.16em;
	}

	.hype-note-quote {
		margin: 0;
		padding: 0.8rem 0.95rem 0.85rem;
		font-family: var(--font-sans);
		font-style: italic;
		font-size: 16px;
		line-height: 1.5;
		letter-spacing: -0.005em;
		color: var(--ink);
	}

	.hype-note.compact {
		margin: 0.55rem 0 0;
		box-shadow: 3px 3px 0 var(--green-shadow);
	}

	.hype-note.compact .hype-note-bar {
		padding: 0.2rem 0.65rem;
		font-size: 10px;
	}

	.hype-note.compact .hype-note-quote {
		padding: 0.55rem 0.7rem 0.6rem;
		font-size: 14.5px;
		line-height: 1.45;
	}
</style>
