---
// An image, optionally dressed in a browser window or phone bezel.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	frame?: 'none' | 'browser' | 'phone';
	url?: string;
	sizes?: string;
	eager?: boolean;
	/** Load immediately at low priority (lazy loading can stall inside horizontal scrollers). */
	preload?: boolean;
	transitionName?: string;
}

const {
	src,
	alt,
	frame = 'none',
	url,
	sizes = '(max-width: 900px) 100vw, 1200px',
	eager = false,
	preload = false,
	transitionName,
} = Astro.props;

const host = url ? new URL(url).host.replace(/^www\./, '') : '';
const isPng = src.format === 'png';
const widths = [480, 800, 1200, 1600, 2400].filter((w) => w < src.width);
if (src.width <= 2400) widths.push(src.width);
---

<div
	class:list={['frame', `frame-${frame}`]}
	style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
>
	{
		frame === 'browser' && (
			<div class="chrome" aria-hidden="true">
				<span class="dots">
					<i />
					<i />
					<i />
				</span>
				{host && <span class="url">{host}</span>}
			</div>
		)
	}
	{frame === 'phone' && <span class="notch" aria-hidden="true" />}
	<Image
		src={src}
		alt={alt}
		widths={widths}
		sizes={sizes}
		format={isPng ? 'webp' : 'avif'}
		loading={eager || preload ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : preload ? 'low' : undefined}
		decoding="async"
	/>
</div>

<style>
	.frame {
		position: relative;
		overflow: hidden;
	}

	.frame :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.frame-browser {
		border-radius: 14px;
		background: #fff;
		box-shadow:
			0 0 0 1px color-mix(in oklab, currentColor 14%, transparent),
			0 30px 80px -30px rgba(0, 0, 0, 0.45);
	}

	.chrome {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 2.25rem;
		padding: 0 0.9rem;
		background: #f1f0ee;
		border-bottom: 1px solid #e2e0dc;
	}

	.dots {
		display: flex;
		gap: 6px;
	}

	.dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #d6d3ce;
	}

	.dots i:nth-child(1) {
		background: #ff5f57;
	}
	.dots i:nth-child(2) {
		background: #febc2e;
	}
	.dots i:nth-child(3) {
		background: #28c840;
	}

	.url {
		flex: 0 1 22rem;
		margin: 0 auto;
		padding: 0.15rem 0.75rem;
		border-radius: 999px;
		background: #fff;
		color: #6a6762;
		font: 500 0.72rem/1.5 ui-monospace, 'SF Mono', Menlo, monospace;
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.frame-phone {
		width: min(100%, 360px);
		margin-inline: auto;
		padding: 10px;
		border-radius: 46px;
		background: #111;
		box-shadow:
			inset 0 0 0 2px #2b2b2b,
			0 30px 80px -30px rgba(0, 0, 0, 0.55);
	}

	.frame-phone :global(img) {
		border-radius: 36px;
	}

	.notch {
		position: absolute;
		top: 20px;
		left: 50%;
		translate: -50% 0;
		width: 30%;
		height: 26px;
		border-radius: 999px;
		background: #111;
		z-index: 1;
	}
</style>
