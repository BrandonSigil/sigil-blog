---
// Template: Product. For apps and platforms. Centered headline over soft
// color blooms, the product shot tilting flat as you scroll, then numbers,
// a feature grid, and the build story.
import { render, type CollectionEntry } from 'astro:content';
import Frame from '../Frame.astro';
import CaseMeta from '../CaseMeta.astro';
import CaseGallery from '../CaseGallery.astro';
import Palette from '../Palette.astro';

interface Props {
	entry: CollectionEntry<'work'>;
	index: number;
}

const { entry, index } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<header class="p-hero">
	<div class="p-blooms" aria-hidden="true"><i></i><i></i><i></i></div>
	<div class="case-wrap p-hero-copy">
		<p class="case-kicker mono">
			<span class="dot" aria-hidden="true"></span>
			<span>Case {String(index).padStart(2, '0')}</span>
			<span>{d.disciplines.join(' / ')}</span>
			<span>{d.year}</span>
		</p>
		<h1 class="case-title p-title" style={`view-transition-name: case-title-${entry.id}`}>{d.title}</h1>
		<p class="p-summary">{d.summary}</p>
		<div class="p-actions">
			{d.url && <a class="case-btn" href={d.url} target="_blank" rel="noopener">Visit {new URL(d.url).host.replace(/^www\./, '')} ↗</a>}
			<a class="case-btn ghost" href="#story">Read the story</a>
		</div>
	</div>
	<div class="case-wrap p-stage">
		<div class="p-device">
			<Frame src={d.cover} alt={d.coverAlt} sizes="(max-width: 1240px) 100vw, 1200px" eager transitionName={`case-media-${entry.id}`} />
		</div>
	</div>
</header>

{
	d.stats.length > 0 && (
		<section class="p-stats" aria-label="By the numbers">
			<div class="case-wrap p-stats-grid">
				{d.stats.map((s) => (
					<div class="p-stat reveal">
						<span class="p-stat-value" data-count={s.value}>
							{s.value}
						</span>
						<span class="p-stat-label">{s.label}</span>
					</div>
				))}
			</div>
		</section>
	)
}

<section class="case-wrap case-section p-intro" id="story">
	<p class="case-lede reveal">{d.lede}</p>
	<CaseMeta data={d} include={['client', 'year', 'role', 'stack', 'url']} />
</section>

{
	d.features.length > 0 && (
		<section class="case-wrap p-features" aria-labelledby="features-label">
			<div class="section-label">
				<h2 id="features-label" class="mono">What it does</h2>
				<span class="mono">{String(d.features.length).padStart(2, '0')} features</span>
			</div>
			<div class="p-feature-grid" data-spotlight>
				{d.features.map((f, i) => (
					<article class="p-feature reveal">
						<span class="mono">{String(i + 1).padStart(2, '0')}</span>
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</article>
				))}
			</div>
		</section>
	)
}

<section class="case-wrap case-section">
	<div class="chapters">
		<Content />
	</div>
</section>

<CaseGallery items={d.gallery} url={d.url} />

{
	d.palette.length > 0 && (
		<section class="case-wrap case-section reveal" aria-labelledby="p-palette-label">
			<div class="section-label">
				<h2 id="p-palette-label" class="mono">Brand color</h2>
				<span class="mono">Click a swatch to copy</span>
			</div>
			<Palette colors={d.palette} />
		</section>
	)
}

{
	d.stack.length > 0 && (
		<section class="case-wrap p-stack">
			<span class="mono">Built with</span>
			<ul class="chips">
				{d.stack.map((s) => (
					<li>{s}</li>
				))}
			</ul>
		</section>
	)
}

<script>
	// Cursor spotlight on the feature cards.
	document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((grid) => {
		grid.addEventListener('pointermove', (e) => {
			for (const card of grid.children as HTMLCollectionOf<HTMLElement>) {
				const r = card.getBoundingClientRect();
				card.style.setProperty('--mx', `${e.clientX - r.left}px`);
				card.style.setProperty('--my', `${e.clientY - r.top}px`);
			}
		});
	});
</script>

<style>
	.p-hero {
		position: relative;
		overflow: hidden;
		padding-top: calc(var(--header-h) + clamp(3rem, 9vw, 7rem));
		text-align: center;
		isolation: isolate;
	}

	.p-blooms {
		position: absolute;
		inset: 0;
		z-index: -1;
		filter: blur(70px);
		opacity: 0.55;
	}

	.p-blooms i {
		position: absolute;
		border-radius: 50%;
		background: var(--c-accent);
	}

	.p-blooms i:nth-child(1) {
		width: 38vw;
		height: 38vw;
		left: -8vw;
		top: 4vw;
	}

	.p-blooms i:nth-child(2) {
		width: 30vw;
		height: 30vw;
		right: -6vw;
		top: -6vw;
		background: color-mix(in oklab, var(--c-accent) 50%, #b04cff);
	}

	.p-blooms i:nth-child(3) {
		width: 26vw;
		height: 26vw;
		right: 18vw;
		top: 30vw;
		background: color-mix(in oklab, var(--c-accent) 35%, #e6ff5a);
		opacity: 0.8;
	}

	@media (prefers-reduced-motion: no-preference) {
		.p-blooms i {
			animation: drift 18s ease-in-out infinite alternate;
		}
		.p-blooms i:nth-child(2) {
			animation-duration: 23s;
			animation-direction: alternate-reverse;
		}
		.p-blooms i:nth-child(3) {
			animation-duration: 15s;
		}
	}

	@keyframes drift {
		to {
			translate: 6vw 4vw;
			scale: 1.15;
		}
	}

	.p-hero-copy {
		display: grid;
		justify-items: center;
		gap: 1.5rem;
	}

	.p-hero-copy .case-kicker {
		justify-content: center;
	}

	.p-title {
		font-size: clamp(3.2rem, 10vw, 9rem);
	}

	.p-summary {
		margin: 0;
		max-width: 46ch;
		font-size: clamp(1.05rem, 1.6vw, 1.3rem);
		line-height: 1.5;
		color: var(--c-muted);
		text-wrap: balance;
	}

	.p-actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.p-stage {
		margin-top: clamp(3rem, 7vw, 5rem);
		perspective: 1600px;
	}

	.p-device {
		border-radius: 18px;
		overflow: hidden;
		box-shadow:
			0 0 0 1px color-mix(in oklab, var(--c-ink) 12%, transparent),
			0 50px 120px -40px rgba(0, 0, 0, 0.55);
		transform-origin: 50% 100%;
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.p-device {
				animation: p-tilt linear both;
				animation-timeline: view();
				animation-range: entry 10% cover 45%;
			}
		}
	}

	@keyframes p-tilt {
		from {
			transform: rotateX(24deg) scale(0.92) translateY(40px);
		}
		to {
			transform: none;
		}
	}

	.p-stats {
		border-block: 1px solid var(--c-line);
		margin-top: clamp(3rem, 7vw, 5rem);
	}

	.p-stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
	}

	.p-stat {
		display: grid;
		gap: 0.5rem;
		padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
		border-left: 1px solid var(--c-line);
	}

	.p-stat:first-child {
		border-left: 0;
		padding-left: 0;
	}

	.p-stat-value {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-size: clamp(2.5rem, 5.5vw, 4.5rem);
		font-weight: 700;
		letter-spacing: -0.05em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		color: var(--c-accent);
	}

	.p-stat-label {
		color: var(--c-muted);
		font-size: 0.95rem;
		line-height: 1.4;
	}

	.p-intro {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}

	.p-intro :global(.case-meta) {
		grid-template-columns: 1fr 1fr;
	}

	.p-features h2 {
		margin: 0;
		font-size: 0.75rem;
	}

	.p-feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 1px;
		background: var(--c-line);
		border: 1px solid var(--c-line);
		border-radius: 18px;
		overflow: hidden;
	}

	.p-feature {
		--mx: -999px;
		--my: -999px;
		display: grid;
		align-content: start;
		gap: 0.75rem;
		padding: clamp(1.5rem, 3vw, 2.25rem);
		background:
			radial-gradient(320px circle at var(--mx) var(--my), color-mix(in oklab, var(--c-accent) 18%, transparent), transparent 70%),
			var(--c-bg);
		min-height: 15rem;
	}

	.p-feature .mono {
		color: var(--c-accent);
	}

	.p-feature h3 {
		margin: 0;
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-size: 1.4rem;
		letter-spacing: -0.02em;
	}

	.p-feature p {
		margin: 0;
		color: var(--c-muted);
		font-size: 1rem;
		line-height: 1.55;
	}

	.p-stack {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		padding-bottom: clamp(3rem, 7vw, 5rem);
		color: var(--c-muted);
	}

	.p-stack .chips {
		color: var(--c-ink);
	}

	@media (max-width: 860px) {
		.p-intro {
			grid-template-columns: 1fr;
		}
		.p-stat {
			border-left: 0;
			border-top: 1px solid var(--c-line);
			padding-left: 0;
		}
		.p-stat:first-child {
			border-top: 0;
		}
	}
</style>
