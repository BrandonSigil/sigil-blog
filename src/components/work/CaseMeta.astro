---
import type { CollectionEntry } from 'astro:content';

interface Props {
	data: CollectionEntry<'work'>['data'];
	include?: ('client' | 'year' | 'role' | 'services' | 'stack' | 'url')[];
}

const { data: d, include = ['client', 'year', 'role', 'services', 'url'] } = Astro.props;
const host = d.url ? new URL(d.url).host.replace(/^www\./, '') : '';
---

<dl class="case-meta">
	{
		include.includes('client') && (
			<div>
				<dt class="mono">Client</dt>
				<dd>{d.client}</dd>
			</div>
		)
	}
	{
		include.includes('year') && (
			<div>
				<dt class="mono">Year</dt>
				<dd>{d.year}</dd>
			</div>
		)
	}
	{
		include.includes('role') && (
			<div>
				<dt class="mono">Role</dt>
				<dd>{d.role}</dd>
			</div>
		)
	}
	{
		include.includes('services') && (
			<div>
				<dt class="mono">Services</dt>
				<dd>
					<ul>
						{d.services.map((s) => (
							<li>{s}</li>
						))}
					</ul>
				</dd>
			</div>
		)
	}
	{
		include.includes('stack') && d.stack.length > 0 && (
			<div>
				<dt class="mono">Stack</dt>
				<dd>
					<ul>
						{d.stack.map((s) => (
							<li>{s}</li>
						))}
					</ul>
				</dd>
			</div>
		)
	}
	{
		include.includes('url') && d.url && (
			<div>
				<dt class="mono">Live</dt>
				<dd>
					<a href={d.url} rel="noopener" target="_blank">
						{host} ↗
					</a>
				</dd>
			</div>
		)
	}
</dl>
