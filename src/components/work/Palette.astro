---
interface Props {
	colors: { name: string; hex: string }[];
}

const { colors } = Astro.props;

// Pick black or white text for each swatch by relative luminance.
function inkFor(hex: string) {
	const h = hex.replace('#', '');
	const [r, g, b] = [0, 2, 4].map((i) => {
		const c = parseInt(h.slice(i, i + 2), 16) / 255;
		return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
	});
	const L = 0.2126 * r + 0.7152 * g + 0.0722 * b;
	return L > 0.32 ? '#111111' : '#ffffff';
}
---

<div class="palette" role="list">
	{
		colors.map((c) => (
			<button
				type="button"
				class="swatch"
				role="listitem"
				data-hex={c.hex}
				style={`--sw:${c.hex};--sw-ink:${inkFor(c.hex)}`}
				aria-label={`${c.name}, ${c.hex}. Copy hex value`}
			>
				<strong>{c.name}</strong>
				<span class="hex mono">{c.hex}</span>
			</button>
		))
	}
</div>
