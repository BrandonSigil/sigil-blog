---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import NmfPoster from './NmfPoster.astro';
import TastingNote from './TastingNote.astro';
import {
	categoryLabel,
	estimateReadTime,
	formatShortDate,
	getPostCoverMosaic,
	getSpotlightCover,
	inferCategory,
	parseNmfPost,
} from '../lib/music';

interface Props {
	post: CollectionEntry<'blog'>;
	variant?: 'lead' | 'grid' | 'compact';
}

const { post, variant = 'grid' } = Astro.props;
const cat = inferCategory(post);
const label = categoryLabel(post);
const readMin = estimateReadTime(post.body);
const mosaic = getPostCoverMosaic(post);
const spotlight = getSpotlightCover(post);
const parsedNmf = cat === 'nmf' ? parseNmfPost(post) : null;
const albums = parsedNmf?.albums ?? [];
const albumCount = albums.length;
const firstTasting = albums.find((a) => a.tastingNote)?.tastingNote;
const isSigilPick = post.data.sigilPick || (post.data.rating !== undefined && post.data.rating >= 8.5);
const href = `/blog/${post.id}`;
const searchBlob = [
	post.data.title,
	post.data.artist,
	post.data.description,
	label,
	...albums.map((a) => `${a.artist} ${a.album} ${a.tastingNote ?? ''}`),
]
	.filter(Boolean)
	.join(' ')
	.toLowerCase();
---

<article
	class:list={['post-card', `variant-${variant}`]}
	data-post-card
	data-category={cat}
	data-search={searchBlob}
>
	<a href={href} class="card-link">
		{variant !== 'compact' && (
			<div class="card-media">
				{cat === 'nmf' ? (
					<NmfPoster
						image={spotlight}
						title={post.data.title}
						slug={post.id}
						dateLabel={formatShortDate(post.data.pubDate)}
						size={variant === 'lead' ? 'hero' : 'card'}
					/>
				) : post.data.heroImage ? (
					<Image
						src={post.data.heroImage}
						alt={post.data.title}
						width={variant === 'lead' ? 880 : 640}
						height={variant === 'lead' ? 550 : 400}
					/>
				) : (
					<div class="media-fallback">
						<span class="fallback-kicker">{label}</span>
						<span class="fallback-title">{post.data.title}</span>
					</div>
				)}

				{post.data.rating !== undefined && (
					<div class="score-badge">
						<span class="score-num">{post.data.rating.toFixed(1)}</span>
						{isSigilPick && <span class="score-tag">Sigil Pick</span>}
					</div>
				)}
			</div>
		)}

		<div class="card-body">
			<div class="card-meta-top">
				<span class="kicker">{label}</span>
				<span class="mono-meta">{formatShortDate(post.data.pubDate)}</span>
			</div>

			{post.data.artist && <div class="card-artist">{post.data.artist}</div>}
			<h3 class="card-title">{post.data.title}</h3>
			<p class="card-desc">{post.data.description}</p>

			{variant === 'lead' && albums.length > 0 && (
				<ul class="lead-tracklist" aria-label="Albums in this issue">
					{albums.slice(0, 4).map((a) => (
						<li>
							<span class="tl-num">{String(a.index).padStart(2, '0')}</span>
							<strong>{a.artist}</strong>
							<span class="tl-sep">—</span>
							<span>{a.album}</span>
						</li>
					))}
				</ul>
			)}

			{variant === 'lead' && firstTasting && <TastingNote note={firstTasting} compact={true} />}

			<div class="card-footer">
				<div class="card-footer-left">
					{variant === 'grid' && mosaic.length > 0 && (
						<div class="mini-pips" aria-hidden="true">
							{mosaic.slice(0, 4).map((img) => (
								<Image src={img} alt="" width={40} height={40} />
							))}
						</div>
					)}
					<span class="mono-meta">
						{cat === 'nmf' && albumCount > 0 ? `${albumCount} ${albumCount === 1 ? 'album' : 'albums'} · ` : ''}
						{readMin} min
					</span>
				</div>
				<span class="card-read-cta">Open →</span>
			</div>
		</div>
	</a>
</article>

<style>
	.post-card {
		background: var(--paper-card);
		border: 1px solid var(--rule-strong);
		border-radius: 6px;
		overflow: hidden;
		transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
	}

	.post-card:hover {
		border-color: var(--ink);
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 var(--ink);
	}

	.card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	/* Lead editorial card — tight, balanced, zero dead space */
	.variant-lead {
		border: 2px solid var(--ink);
		box-shadow: 6px 6px 0 rgba(20, 38, 26, 0.14);
	}

	.variant-lead:hover {
		box-shadow: 8px 8px 0 var(--ink);
	}

	.variant-lead .card-link {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		align-items: stretch;
	}

	.variant-lead .card-media {
		aspect-ratio: auto;
		width: 100%;
		min-width: 0;
		height: 100%;
		min-height: 300px;
		border-right: 2px solid var(--ink);
	}

	.variant-lead .card-body {
		min-width: 0;
		padding: 1.5rem 1.75rem 1.35rem;
		justify-content: space-between;
	}

	.variant-lead .card-title {
		font-size: clamp(1.65rem, 2.7vw, 2.3rem);
		margin-bottom: 0.55rem;
	}

	.variant-lead .card-desc {
		font-size: 0.96rem;
		line-height: 1.52;
		margin-bottom: 0.9rem;
		-webkit-line-clamp: 3;
	}

	.lead-tracklist {
		list-style: none;
		padding: 0.65rem 0;
		margin: 0 0 0.75rem;
		border-top: 1px dashed var(--rule-strong);
		border-bottom: 1px dashed var(--rule-strong);
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	.lead-tracklist li {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tl-num {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--green);
	}

	.lead-tracklist strong {
		color: var(--ink);
		font-weight: 600;
	}

	.tl-sep {
		color: var(--gray);
	}

	/* Media container */
	.card-media {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #141413;
	}

	.card-media > :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 0.35s ease;
	}

	.post-card:hover .card-media > :global(img),
	.post-card:hover .card-media :global(.poster-art-wrap img) {
		transform: scale(1.04);
	}

	.media-fallback {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, #1b3a1c 0%, #3e7d3c 100%);
		color: #f7f6f1;
		padding: 1.35rem;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.35rem;
	}

	.fallback-kicker {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		opacity: 0.8;
	}

	.fallback-title {
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-weight: 700;
		line-height: 1.1;
	}

	.score-badge {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		z-index: 6;
		background: #141413;
		color: #f7f6f1;
		padding: 0.38rem 0.6rem;
		border-radius: 4px;
		border: 1.5px solid #f7f6f1;
		display: flex;
		flex-direction: column;
		align-items: center;
		line-height: 1;
	}

	.score-num {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 700;
	}

	.score-tag {
		font-family: var(--font-mono);
		font-size: 0.58rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #9ed29c;
		margin-top: 0.18rem;
	}

	/* Card text */
	.card-body {
		padding: 1.05rem 1.15rem 1rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.card-meta-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.45rem;
	}

	.card-artist {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--gray);
		margin-bottom: 0.15rem;
	}

	.card-title {
		font-family: var(--font-display);
		font-size: 1.22rem;
		line-height: 1.16;
		color: var(--ink);
		margin: 0 0 0.4rem;
		transition: color 0.16s ease;
	}

	.post-card:hover .card-title {
		color: var(--green);
	}

	.card-desc {
		margin: 0 0 0.85rem;
		font-size: 0.9rem;
		line-height: 1.48;
		color: var(--ink-soft);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-footer {
		margin-top: auto;
		padding-top: 0.65rem;
		border-top: 1px solid var(--rule);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.card-footer-left {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.mini-pips {
		display: flex;
		align-items: center;
	}

	.mini-pips :global(img) {
		width: 22px;
		height: 22px;
		border-radius: 3px;
		object-fit: cover;
		border: 1.5px solid var(--paper-card);
		margin-left: -5px;
	}

	.mini-pips :global(img:first-child) {
		margin-left: 0;
	}

	.card-read-cta {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--ink);
		transition: color 0.16s ease, transform 0.16s ease;
	}

	.post-card:hover .card-read-cta {
		color: var(--green);
		transform: translateX(2px);
	}

	@media (max-width: 880px) {
		.variant-lead .card-link {
			grid-template-columns: 1fr;
		}

		.variant-lead .card-media {
			aspect-ratio: 16 / 10;
			min-height: 220px;
			border-right: none;
			border-bottom: 2px solid var(--ink);
		}

		.variant-lead .card-body {
			padding: 1.25rem;
		}
	}
</style>
