---
import ListenIcons from './ListenIcons.astro';
import { buildSearchLinks, getUpcomingReleases, groupUpcomingByDate } from '../lib/music';

interface Props {
	maxGroups?: number;
	heading?: string;
}

const { maxGroups = 4, heading = 'On our radar' } = Astro.props;

const allReleases = getUpcomingReleases();
const groups = groupUpcomingByDate(allReleases).slice(0, maxGroups);
---

<section class="radar-section" aria-label="Upcoming album releases">
	<div class="radar-header">
		<div>
			<span class="kicker">Release Radar</span>
			<h2>{heading}</h2>
		</div>
		<div class="radar-header-actions">
			<a href="/releases.ics" class="btn-ghost" download data-tick>↓ .ics Feed</a>
			<a href="/calendar" class="radar-all-link" data-tick>All {allReleases.length} drops →</a>
		</div>
	</div>

	<div class="radar-ledger">
		{groups.map((group) => (
			<div class="ledger-group">
				<div class="ledger-date-col">
					<time class="ledger-date">{group.abbrevDate}</time>
				</div>

				<div class="ledger-items-col">
					{group.items.map((item) => {
						const links = buildSearchLinks(item.artist, item.title);
						return (
							<article class="ledger-row">
								<div class="ledger-main">
									<div class="ledger-title-line">
										<strong>{item.artist}</strong>
										<span class="ledger-dash">—</span>
										<span class="ledger-album">{item.title}</span>
										{item.label && <span class="ledger-label">{item.label}</span>}
									</div>
									<p class="ledger-why">{item.why}</p>
								</div>

								<div class="ledger-right">
									<span class="ledger-lane">{item.lane}</span>
									<ListenIcons
										spotifyUrl={links.spotifyUrl}
										youtubeUrl={links.youtubeUrl}
										bandcampUrl={links.bandcampUrl}
										appleMusicUrl={links.appleMusicUrl}
										labelPrefix={`${item.artist} — ${item.title}`}
										compact={true}
									/>
								</div>
							</article>
						);
					})}
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.radar-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1.25rem;
		flex-wrap: wrap;
		margin-bottom: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--green);
	}

	.radar-header h2 {
		margin: 0.35rem 0 0;
	}

	.radar-header-actions {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.radar-all-link {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		color: var(--green);
	}

	.radar-ledger {
		background: var(--paper-card);
		border: 1px solid var(--rule-strong);
		border-radius: 6px;
		overflow: hidden;
	}

	.ledger-group {
		display: grid;
		grid-template-columns: 108px minmax(0, 1fr);
		border-top: 1px solid var(--rule-strong);
	}

	.ledger-group:first-child {
		border-top: none;
	}

	.ledger-date-col {
		padding: 0.9rem 1rem;
		border-right: 1px solid var(--rule);
		background: var(--green-tint);
	}

	.ledger-date {
		position: sticky;
		top: 5.5rem;
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--green);
		white-space: nowrap;
	}

	.ledger-items-col {
		min-width: 0;
	}

	.ledger-row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.8rem 1.15rem;
		border-top: 1px solid var(--rule);
		transition: background-color 50ms steps(2);
	}

	.ledger-row::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--green);
		opacity: 0;
	}

	.ledger-row:first-child {
		border-top: none;
	}

	.ledger-row:hover {
		background-color: var(--green-tint);
		background-image: var(--hatch-green);
	}

	.ledger-row:hover::before {
		opacity: 1;
	}

	.ledger-main {
		min-width: 0;
		flex: 1;
	}

	.ledger-title-line {
		font-size: 15px;
		line-height: 1.35;
		color: var(--ink);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.32rem;
	}

	.ledger-title-line strong {
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.ledger-dash {
		color: var(--gray);
	}

	.ledger-album {
		color: var(--ink);
	}

	.ledger-label {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--gray);
		margin-left: 0.25rem;
	}

	.ledger-why {
		margin: 0.12rem 0 0;
		font-size: 13.5px;
		line-height: 1.45;
		color: var(--ink-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.ledger-right {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
	}

	.ledger-lane {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.04em;
		padding: 0.16rem 0.5rem;
		border-radius: 999px;
		background: var(--gray-lighter);
		color: var(--ink-soft);
		white-space: nowrap;
	}

	@media (max-width: 820px) {
		.ledger-group {
			grid-template-columns: 1fr;
		}

		.ledger-date-col {
			padding: 0.55rem 1rem;
			border-right: none;
			border-bottom: 1px solid var(--rule);
		}

		.ledger-date {
			position: static;
		}

		.ledger-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.55rem;
			padding: 0.85rem 1rem;
		}

		.ledger-why {
			white-space: normal;
		}

		.ledger-right {
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
