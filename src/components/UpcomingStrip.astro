---
import { buildSearchLinks, formatReleaseDate, getUpcomingReleases } from '../lib/music';

interface Props {
	limit?: number;
	heading?: string;
	subheading?: string;
}

const {
	limit = 8,
	heading = 'On Our Radar',
	subheading = 'Forthcoming albums worth marking down — auto-synced from the Sigil release calendar.',
} = Astro.props;

const upcoming = getUpcomingReleases().slice(0, limit);
---

<section class="radar-section" aria-label="Upcoming album releases">
	<div class="radar-header">
		<div>
			<span class="kicker">Release Radar</span>
			<h2>{heading}</h2>
			<p class="radar-sub">{subheading}</p>
		</div>
		<div class="radar-header-actions">
			<a href="/releases.ics" class="btn-ghost" download>↓ .ics Feed</a>
			<a href="/calendar" class="radar-all-link">All {getUpcomingReleases().length} drops →</a>
		</div>
	</div>

	<div class="radar-ledger">
		{upcoming.map((item) => {
			const links = buildSearchLinks(item.artist, item.title);
			return (
				<article class="ledger-row">
					<time class="ledger-date">{formatReleaseDate(item.releaseDate)}</time>
					<div class="ledger-main">
						<div class="ledger-title-line">
							<strong>{item.artist}</strong>
							<span class="ledger-dash">—</span>
							<span class="ledger-album">{item.title}</span>
							{item.label && <span class="ledger-label">({item.label})</span>}
						</div>
						<p class="ledger-why">{item.why}</p>
					</div>
					<span class="ledger-lane">{item.lane}</span>
					<a
						href={links.spotifyUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="ledger-link"
						aria-label={`Search ${item.artist} — ${item.title} on Spotify`}
					>
						Spotify ↗
					</a>
				</article>
			);
		})}
	</div>
</section>

<style>
	.radar-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1.25rem;
		flex-wrap: wrap;
		margin-bottom: 1.25rem;
		padding-bottom: 0.9rem;
		border-bottom: 2px solid var(--ink);
	}

	.radar-header h2 {
		margin: 0.2rem 0 0.15rem;
	}

	.radar-sub {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}

	.radar-header-actions {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.radar-all-link {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--green);
	}

	.radar-ledger {
		background: var(--paper-card);
		border: 1.5px solid var(--ink);
		border-radius: 6px;
		box-shadow: 5px 5px 0 rgba(20, 38, 26, 0.1);
		overflow: hidden;
	}

	.ledger-row {
		display: grid;
		grid-template-columns: 145px minmax(0, 1fr) 128px 82px;
		gap: 0.75rem 1.15rem;
		align-items: center;
		padding: 0.8rem 1.15rem;
		border-top: 1px solid var(--rule);
		transition: background 0.14s ease;
	}

	.ledger-row:first-child {
		border-top: none;
	}

	.ledger-row:hover {
		background: var(--green-tint);
	}

	.ledger-date {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--green);
		white-space: nowrap;
	}

	.ledger-main {
		min-width: 0;
	}

	.ledger-title-line {
		font-size: 0.96rem;
		line-height: 1.3;
		color: var(--ink);
	}

	.ledger-title-line strong {
		font-family: var(--font-display);
		font-weight: 700;
	}

	.ledger-dash {
		margin: 0 0.3rem;
		color: var(--gray);
	}

	.ledger-album {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.02rem;
	}

	.ledger-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--gray);
		margin-left: 0.35rem;
	}

	.ledger-why {
		margin: 0.15rem 0 0;
		font-size: 0.84rem;
		line-height: 1.4;
		color: var(--ink-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.ledger-lane {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		padding: 0.18rem 0.52rem;
		border-radius: 999px;
		background: var(--gray-lighter);
		color: var(--ink-soft);
		text-align: center;
		white-space: nowrap;
	}

	.ledger-link {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--ink);
		text-align: right;
		white-space: nowrap;
	}

	.ledger-link:hover {
		color: var(--green);
		text-decoration: underline;
	}

	@media (max-width: 820px) {
		.ledger-row {
			grid-template-columns: 1fr auto;
			gap: 0.35rem 0.75rem;
			padding: 0.85rem 1rem;
		}

		.ledger-date {
			grid-column: 1;
		}

		.ledger-lane {
			grid-column: 2;
			justify-self: end;
		}

		.ledger-main {
			grid-column: 1 / -1;
		}

		.ledger-why {
			white-space: normal;
		}

		.ledger-link {
			grid-column: 1 / -1;
			text-align: left;
		}
	}
</style>
