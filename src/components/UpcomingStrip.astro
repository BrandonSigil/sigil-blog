---
import { formatReleaseDate, getUpcomingReleases } from '../lib/music';

interface Props {
	limit?: number;
	heading?: string;
	subheading?: string;
}

const {
	limit = 6,
	heading = 'On Our Radar',
	subheading = 'Upcoming albums tracked by Sigil’s weekly release radar.',
} = Astro.props;

const upcoming = getUpcomingReleases().slice(0, limit);
---

<section class="radar-section" aria-label="Upcoming album releases">
	<div class="radar-header">
		<div>
			<span class="kicker">Release Radar</span>
			<h2>{heading}</h2>
			<p class="radar-sub">{subheading}</p>
		</div>
		<div class="radar-header-actions">
			<a href="/releases.ics" class="btn-ghost" download>Subscribe .ics</a>
			<a href="/calendar" class="radar-all-link">Full calendar →</a>
		</div>
	</div>

	<div class="radar-grid">
		{upcoming.map((item) => (
			<article class="radar-card">
				<div class="radar-card-top">
					<time class="radar-date">{formatReleaseDate(item.releaseDate)}</time>
					<span class="radar-lane">{item.lane}</span>
				</div>
				<h3 class="radar-title">{item.title}</h3>
				<div class="radar-artist">
					{item.artist}
					{item.label && <span class="radar-label"> · {item.label}</span>}
				</div>
				<p class="radar-why">{item.why}</p>
			</article>
		))}
	</div>
</section>

<style>
	.radar-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1.25rem;
		flex-wrap: wrap;
		margin-bottom: 1.75rem;
		padding-bottom: 1.15rem;
		border-bottom: 1.5px solid var(--green);
	}

	.radar-header h2 {
		margin: 0.25rem 0 0.2rem;
	}

	.radar-sub {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.98rem;
	}

	.radar-header-actions {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.radar-all-link {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--green);
	}

	.radar-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.15rem;
	}

	.radar-card {
		background: var(--paper-card);
		border: 1px solid var(--rule);
		border-radius: var(--radius-md);
		padding: 1.15rem 1.2rem;
		display: flex;
		flex-direction: column;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.radar-card:hover {
		border-color: var(--green);
		transform: translateY(-2px);
	}

	.radar-card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.6rem;
	}

	.radar-date {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--green);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.radar-lane {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		padding: 0.16rem 0.5rem;
		border-radius: 999px;
		background: var(--gray-lighter);
		color: var(--ink-soft);
	}

	.radar-title {
		font-family: var(--font-display);
		font-size: 1.15rem;
		line-height: 1.2;
		color: var(--ink);
		margin: 0 0 0.2rem;
	}

	.radar-artist {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--ink-soft);
		margin-bottom: 0.65rem;
	}

	.radar-label {
		font-weight: 400;
		color: var(--gray);
	}

	.radar-why {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--gray);
	}

	@media (max-width: 960px) {
		.radar-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.radar-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
