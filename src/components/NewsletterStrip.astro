---
import { NEWSLETTER_ACTION_URL, SIGIL_PLAYLIST_URL } from '../consts';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={['dispatch-window', { compact }]} aria-label="Friday Dispatch newsletter">
	<div class="dw-titlebar" aria-hidden="true">
		<span class="dw-box"></span>
		<span class="dw-stripes"></span>
		<span class="dw-title">Friday_Dispatch.txt</span>
		<span class="dw-stripes"></span>
	</div>

	<div class="dw-body">
		<div class="dispatch-copy">
			<span class="kicker">Weekly Note · Zero Spam</span>
			<h3>{compact ? 'Get Friday’s crate in your inbox.' : 'Great records, zero algorithmic noise.'}</h3>
			<p>
				One short, human-written note every Friday with the best new albums, tasting notes, and upcoming drops.
			</p>
		</div>

		<div class="dispatch-actions">
			<form
				class="dispatch-form"
				data-newsletter-form
				action={NEWSLETTER_ACTION_URL || undefined}
				method={NEWSLETTER_ACTION_URL ? 'post' : undefined}
			>
				<label class="sr-only" for={compact ? 'email-compact' : 'email-main'}>Email address</label>
				<input
					id={compact ? 'email-compact' : 'email-main'}
					type="email"
					name="email"
					placeholder="you@domain.com"
					required
					autocomplete="email"
				/>
				<button type="submit">Subscribe →</button>
			</form>
			<p class="dispatch-status" data-newsletter-status aria-live="polite"></p>
		</div>
	</div>

	<div class="dw-status">
		<span>Sigil HD / Dispatch</span>
		<div class="dispatch-alts">
			<a href="/rss.xml">RSS Feed</a>
			<span aria-hidden="true">·</span>
			<a href="/releases.ics">Calendar (.ics)</a>
			<span aria-hidden="true">·</span>
			<a href={SIGIL_PLAYLIST_URL} target="_blank" rel="noopener noreferrer">Spotify Playlist ↗</a>
		</div>
	</div>
</aside>

<style>
	.dispatch-window {
		background: var(--paper-card);
		border: 2px solid var(--ink);
		border-radius: 6px;
		box-shadow: 7px 7px 0 var(--green);
		overflow: hidden;
	}

	.dw-titlebar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		height: 2rem;
		padding: 0 0.65rem;
		border-bottom: 2px solid var(--ink);
		background: var(--paper);
		font-family: var(--font-mono);
	}

	.dw-box {
		width: 0.72rem;
		height: 0.72rem;
		border: 1.5px solid var(--ink);
		background: var(--paper-card);
		flex: none;
	}

	.dw-stripes {
		flex: 1;
		height: 0.72rem;
		background: repeating-linear-gradient(to bottom, var(--ink) 0 1px, transparent 1px 4px);
	}

	.dw-title {
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--ink);
		white-space: nowrap;
	}

	.dw-body {
		padding: 1.85rem 2rem;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
		gap: 1.75rem 2.25rem;
		align-items: center;
	}

	.dispatch-window.compact .dw-body {
		padding: 1.4rem 1.65rem;
	}

	.dispatch-copy h3 {
		font-family: var(--font-display);
		color: var(--ink);
		font-size: clamp(1.35rem, 2.4vw, 1.85rem);
		margin: 0.35rem 0 0.4rem;
		line-height: 1.12;
	}

	.dispatch-copy p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.94rem;
		line-height: 1.5;
		max-width: 44ch;
	}

	.dispatch-form {
		display: flex;
		gap: 0.5rem;
	}

	.dispatch-form input {
		flex: 1;
		min-width: 0;
		border: 1.5px solid var(--ink);
		border-radius: 5px;
		background: var(--paper);
		color: var(--ink);
		padding: 0.62rem 0.85rem;
		font-family: var(--font-sans);
		font-size: 0.94rem;
		outline: none;
	}

	.dispatch-form input:focus {
		border-color: var(--green);
		background: #ffffff;
	}

	.dispatch-form button {
		border: 1.5px solid var(--ink);
		background: var(--green);
		color: #ffffff;
		box-shadow: 3px 3px 0 var(--ink);
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 0.82rem;
		padding: 0.62rem 1.1rem;
		border-radius: 5px;
		cursor: pointer;
		white-space: nowrap;
		transition: transform 0.14s ease, box-shadow 0.14s ease, background 0.14s ease;
	}

	.dispatch-form button:hover {
		background: var(--ink);
		transform: translate(-1px, -1px);
		box-shadow: 4px 4px 0 var(--green);
	}

	.dispatch-status {
		margin: 0.45rem 0 0;
		min-height: 1.1em;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--green);
	}

	.dw-status {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		padding: 0.45rem 0.85rem;
		border-top: 1.5px solid var(--ink);
		background: var(--paper);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--gray);
	}

	.dispatch-alts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.dispatch-alts a {
		color: var(--ink);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--rule-green);
		text-underline-offset: 3px;
	}

	.dispatch-alts a:hover {
		color: var(--green);
	}

	@media (max-width: 820px) {
		.dw-body {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			padding: 1.35rem 1.2rem;
		}

		.dispatch-form {
			flex-direction: column;
		}

		.dispatch-form button {
			width: 100%;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
		if (form.getAttribute('action')) return;
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const input = form.querySelector<HTMLInputElement>('input[type="email"]');
			const status = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-status]');
			if (!input || !status) return;
			const email = input.value.trim();
			if (!email) return;
			status.textContent = `Noted (${email}) — newsletter delivery is launching soon. Grab the RSS feed below in the meantime!`;
			input.value = '';
		});
	});
</script>
