---
import { NEWSLETTER_ACTION_URL, SIGIL_PLAYLIST_URL } from '../consts';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={['dispatch-window', { compact }]} aria-label="Friday Dispatch newsletter">
	<div class="dw-titlebar" aria-hidden="true">
		<span class="dw-box"></span>
		<span class="dw-stripes"></span>
		<span class="dw-title">Friday_Dispatch.txt</span>
		<span class="dw-stripes"></span>
	</div>

	<div class="dw-body">
		<div class="dispatch-copy">
			<span class="kicker">Weekly Dispatch</span>
			<h3>{compact ? 'Friday’s picks, by email.' : 'The weekly issue, in your inbox.'}</h3>
			<p>
				One short note every Friday with the best new albums, tasting notes, and upcoming drops worth bookmarking.
			</p>
		</div>

		<div class="dispatch-actions">
			<form
				class="dispatch-form"
				data-newsletter-form
				action={NEWSLETTER_ACTION_URL || undefined}
				method={NEWSLETTER_ACTION_URL ? 'post' : undefined}
			>
				<label class="sr-only" for={compact ? 'email-compact' : 'email-main'}>Email address</label>
				<input
					id={compact ? 'email-compact' : 'email-main'}
					type="email"
					name="email"
					placeholder="you@domain.com"
					required
					autocomplete="email"
				/>
				<button type="submit">Subscribe →</button>
			</form>
			<p class="dispatch-status" data-newsletter-status aria-live="polite"></p>
		</div>
	</div>

	<div class="dw-status">
		<span>Sigil HD / Dispatch</span>
		<div class="dispatch-alts">
			<a href="/rss.xml">RSS Feed</a>
			<span aria-hidden="true">·</span>
			<a href="/releases.ics">Calendar (.ics)</a>
			<span aria-hidden="true">·</span>
			<a href={SIGIL_PLAYLIST_URL} target="_blank" rel="noopener noreferrer">Spotify Playlist ↗</a>
		</div>
	</div>
</aside>

<style>
	.dispatch-window {
		background: var(--paper-card);
		border-radius: 7px;
		box-shadow:
			0 0 0 1px var(--green),
			0 6px 20px -6px rgba(36, 74, 35, 0.14);
		overflow: hidden;
	}

	.dw-titlebar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		height: 1.9rem;
		padding: 0 0.65rem;
		border-bottom: 1px solid var(--green);
		background: var(--paper);
		font-family: var(--font-mono);
	}

	.dw-box {
		width: 0.68rem;
		height: 0.68rem;
		border: 1px solid var(--green);
		background: var(--paper-card);
		flex: none;
	}

	.dw-stripes {
		flex: 1;
		height: 0.68rem;
		background: repeating-linear-gradient(to bottom, var(--green) 0 1px, transparent 1px 4px);
		opacity: 0.7;
	}

	.dw-title {
		font-size: 11px;
		font-weight: 500;
		color: var(--green-dark);
		white-space: nowrap;
	}

	.dw-body {
		padding: 1.85rem 2rem;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
		gap: 1.75rem 2.25rem;
		align-items: center;
	}

	.dispatch-window.compact .dw-body {
		padding: 1.4rem 1.65rem;
	}

	.dispatch-copy h3 {
		font-family: var(--font-display);
		color: var(--ink);
		font-size: clamp(1.35rem, 2.3vw, 1.75rem);
		font-weight: 600;
		letter-spacing: -0.025em;
		margin: 0.35rem 0 0.4rem;
		line-height: 1.08;
	}

	.dispatch-copy p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 15px;
		line-height: 1.55;
		max-width: 44ch;
	}

	.dispatch-form {
		display: flex;
		gap: 0.5rem;
	}

	.dispatch-form input {
		flex: 1;
		min-width: 0;
		border: 1px solid var(--rule-strong);
		border-radius: 5px;
		background: var(--paper);
		color: var(--ink);
		padding: 0.6rem 0.85rem;
		font-family: var(--font-sans);
		font-size: 15px;
		outline: none;
	}

	.dispatch-form input:focus {
		border-color: var(--green);
		background: #ffffff;
	}

	.dispatch-form button {
		border: 1px solid var(--green-dark);
		background: var(--green);
		color: #ffffff;
		box-shadow: 0 1px 2px rgba(28, 62, 28, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.16);
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 12px;
		letter-spacing: 0.04em;
		padding: 0.6rem 1.05rem;
		border-radius: 5px;
		cursor: pointer;
		white-space: nowrap;
		transition:
			transform var(--dur-press) var(--ease-out),
			box-shadow var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.dispatch-form button:hover {
			background: var(--green-dark);
			box-shadow: 0 4px 12px -2px rgba(36, 74, 35, 0.28);
		}
	}

	.dispatch-form button:active {
		transform: scale(0.97);
	}

	.dispatch-status {
		margin: 0.45rem 0 0;
		min-height: 1.1em;
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--green);
	}

	.dw-status {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		padding: 0.45rem 0.85rem;
		border-top: 1px solid var(--rule-strong);
		background: var(--paper);
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--gray);
	}

	.dispatch-alts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.dispatch-alts a {
		color: var(--ink);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--rule-green);
		text-underline-offset: 3px;
	}

	.dispatch-alts a:hover {
		color: var(--green);
	}

	@media (max-width: 820px) {
		.dw-body {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			padding: 1.35rem 1.2rem;
		}

		.dispatch-form {
			flex-direction: column;
		}

		.dispatch-form button {
			width: 100%;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
		if (form.getAttribute('action')) return;
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const input = form.querySelector<HTMLInputElement>('input[type="email"]');
			const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const status = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-status]');
			if (!input || !status) return;
			const email = input.value.trim();
			if (!email) return;
			if (btn) {
				const prev = btn.textContent;
				btn.textContent = '✓ Noted';
				setTimeout(() => {
					btn.textContent = prev;
				}, 2400);
			}
			status.textContent = `Saved (${email}) — newsletter delivery is launching soon. RSS & .ics are live below.`;
			input.value = '';
		});
	});
</script>
