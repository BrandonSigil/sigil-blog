---
// "Browse" links shared by the album index and every hub page: years, genres, artists A–Z.
import { getAlbumPicks } from '../lib/albums';
import { groupByGenre, groupByYear } from '../lib/hubs';

interface Props {
	/** The href of the page being shown, so its link is marked current. */
	current?: string;
}

const { current } = Astro.props;
const picks = await getAlbumPicks();
const years = groupByYear(picks);
const genres = groupByGenre(picks);
const is = (href: string) => (current === href ? 'page' : undefined);
---

<nav class="hub-nav" aria-label="Browse albums">
	<div class="hub-row" data-glide-group>
		<span class="hub-label">Year</span>
		<a href="/albums" aria-current={is('/albums')}>All</a>
		{years.map((y) => <a href={y.href} aria-current={is(y.href)}>{y.year}</a>)}
		<a href="/crate" aria-current={is('/crate')}>The Crate</a>
		<a href="/calendar" aria-current={is('/calendar')}>Release Calendar</a>
	</div>
	<div class="hub-row" data-glide-group>
		<span class="hub-label">Genre</span>
		{genres.map((g) => <a href={g.href} aria-current={is(g.href)}>{g.name}</a>)}
	</div>
	<div class="hub-row" data-glide-group>
		<span class="hub-label">More</span>
		<a href="/artists" aria-current={is('/artists')}>Artists A–Z</a>
		<a href="/news" aria-current={is('/news')}>In the news</a>
	</div>
</nav>

<style>
	.hub-nav {
		display: grid;
		gap: 0.55rem;
		margin-top: 1.5rem;
	}

	.hub-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
	}

	.hub-label {
		width: 4.1rem;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--gray);
	}

	.hub-row a {
		padding: 0.3rem 0.72rem;
		border: 1px solid var(--rule-strong);
		border-radius: 5px;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 11.5px;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
		transition:
			transform var(--dur-press) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.hub-row a:hover {
			border-color: var(--green);
			color: var(--green-dark);
		}
	}

	.hub-row a:active {
		transform: scale(0.96);
	}

	.hub-row a[aria-current='page'] {
		background: var(--green);
		border-color: var(--green);
		color: var(--white);
	}

	@media (max-width: 480px) {
		.hub-label {
			width: 100%;
		}
	}
</style>
