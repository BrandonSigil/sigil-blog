---
// Shell for the album hub pages (/albums/<year>, /albums/<year>/<month>, /genres, /artists, /news):
// the page header, the shared "Browse" links, then the page's own content.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HubNav from '../components/HubNav.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	kicker?: string;
	description: string;
	count?: string;
	current?: string;
}

const { title, kicker, description, count, current } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
		<style>
			.page-header {
				margin-bottom: 2.25rem;
				padding-bottom: 1.75rem;
				border-bottom: 1px solid var(--green);
			}

			.hub-kicker {
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				letter-spacing: 0.13em;
				text-transform: uppercase;
				color: var(--green);
			}

			.hub-kicker :global(a) {
				color: inherit;
			}

			.hub-kicker :global(a:hover) {
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.page-header h1 {
				margin: 0.35rem 0 0;
			}

			.count {
				margin: 0.6rem 0 0;
				font-family: var(--font-mono);
				font-size: 12px;
				letter-spacing: 0.04em;
				color: var(--gray);
				font-variant-numeric: tabular-nums;
			}

			:global(.hub-section) {
				margin-bottom: 3.5rem;
			}

			:global(.hub-section-head) {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 1.35rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--rule-strong);
			}

			:global(.hub-section-head h2) {
				margin: 0;
				font-size: clamp(1.5rem, 3vw, 2.1rem);
			}

			:global(.hub-section-head h2 a) {
				color: inherit;
			}

			:global(.hub-section-head > a) {
				font-family: var(--font-mono);
				font-size: 12px;
				font-weight: 500;
				color: var(--green);
			}

			:global(.hub-muted) {
				color: var(--gray);
				font-family: var(--font-mono);
				font-size: 12px;
				font-variant-numeric: tabular-nums;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-header">
				{kicker && <div class="hub-kicker" set:html={kicker} />}
				<h1>{title}</h1>
				{count && <p class="count">{count}</p>}
				<HubNav current={current} />
			</header>
			<slot />
		</main>
		<Footer />
	</body>
</html>
