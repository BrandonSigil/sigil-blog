---
// Shared shell for every case study template: head, theme tokens,
// reading progress, the "next project" band and the footer.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_STUDIO, SITE_TITLE } from '../consts';
import '../styles/work.css';

interface Props {
	entry: CollectionEntry<'work'>;
	next: CollectionEntry<'work'>;
}

const { entry, next } = Astro.props;
const d = entry.data;
const n = next.data;

const siteUrl = Astro.site?.href ?? 'https://sigil.studio';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: `${d.title} — ${d.client}`,
	description: d.summary,
	url: new URL(`/work/${entry.id}`, siteUrl).href,
	dateCreated: d.year,
	creator: { '@type': 'Organization', name: SITE_STUDIO, url: siteUrl },
	about: d.disciplines.join(', '),
};

const themeVars = `--c-bg:${d.theme.bg};--c-ink:${d.theme.ink};--c-accent:${d.theme.accent};`;
const nextVars = `--n-bg:${n.theme.bg};--n-ink:${n.theme.ink};--n-accent:${n.theme.accent};`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${d.title} — ${d.client} | Work | ${SITE_TITLE}`}
			description={d.summary}
			image={d.cover}
			type="article"
			structuredData={structuredData}
		/>
		<meta name="theme-color" content={d.theme.bg} />
	</head>
	<body>
		<Header />
		<div class="case-progress" aria-hidden="true" style={`--c-accent:${d.theme.accent}`}></div>
		<main class="case" data-template={d.template} style={themeVars}>
			<slot />

			<nav aria-label="Next project">
				<a class="next-case" href={`/work/${next.id}`} style={nextVars}>
					<div class="case-wrap">
						<span class="mono">Next project · {n.client}</span>
					</div>
					<div class="next-marquee" aria-hidden="true">
						{Array.from({ length: 6 }, () => <span>{n.title}</span>)}
					</div>
					<span class="sr-only">{n.title}</span>
					<div class="next-thumb" style={`view-transition-name: case-media-${next.id}`}>
						<Image src={n.cover} alt="" widths={[480, 800]} sizes="22rem" />
					</div>
					<div class="case-wrap">
						<span class="next-cta">View case study <span aria-hidden="true">→</span></span>
					</div>
				</a>
			</nav>
		</main>
		<Footer />

		<script>
			// Click a palette swatch to copy its hex value.
			document.querySelectorAll<HTMLButtonElement>('[data-hex]').forEach((btn) => {
				btn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(btn.dataset.hex ?? '');
						btn.dataset.copied = '';
						setTimeout(() => delete btn.dataset.copied, 1400);
					} catch {
						/* clipboard unavailable; nothing to do */
					}
				});
			});

			// Count up stat values ("300+", "$0", "50,000+") when they scroll in.
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const stats = document.querySelectorAll<HTMLElement>('[data-count]');
			if (!reduce && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							io.unobserve(e.target);
							const el = e.target as HTMLElement;
							const raw = el.dataset.count ?? '';
							const m = raw.match(/^(\D*)([\d,]+)(.*)$/);
							if (!m) continue;
							const [, pre, num, post] = m;
							const target = Number(num.replace(/,/g, ''));
							const t0 = performance.now();
							const dur = 1100;
							const tick = (t: number) => {
								const p = Math.min(1, (t - t0) / dur);
								const eased = 1 - Math.pow(1 - p, 3);
								el.textContent = pre + Math.round(target * eased).toLocaleString('en-US') + post;
								if (p < 1) requestAnimationFrame(tick);
							};
							requestAnimationFrame(tick);
						}
					},
					{ threshold: 0.6 },
				);
				stats.forEach((s) => io.observe(s));
			}
		</script>
	</body>
</html>
