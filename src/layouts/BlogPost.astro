---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ListenIcons from '../components/ListenIcons.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import PostCard from '../components/PostCard.astro';
import SpotifyFacade from '../components/SpotifyFacade.astro';
import TastingNote from '../components/TastingNote.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import {
	categoryLabel,
	estimateReadTime,
	formatAbbrevDate,
	getPublishedPosts,
	getUpcomingReleases,
	inferCategory,
	parseNmfPost,
	renderInlineMarkdown,
} from '../lib/music';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	artist,
	genre,
	label,
	releaseDate,
	rating,
	sigilPick,
	essentialTracks,
	forFansOf,
	listenUrl,
	bandcampUrl,
} = post.data;

const category = inferCategory(post);
const catLabel = categoryLabel(post);
const readMin = estimateReadTime(post.body);
const isSigilPick = sigilPick || (rating !== undefined && rating >= 8.5);
const hasReviewMeta = Boolean(artist || genre || label || releaseDate || rating);

const parsedNmf = category === 'nmf' ? parseNmfPost(post) : null;
const useNmfSpread = Boolean(parsedNmf && parsedNmf.albums.length > 0);

const allPosts = await getPublishedPosts();
const relatedPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 3);
const nextUpReleases = (await getUpcomingReleases()).slice(0, 3);

const siteUrl = Astro.site?.href ?? 'https://sigil.studio';
const ogImageUrl = `/og/${post.id}.png`;

const structuredData =
	rating !== undefined && artist
		? {
				'@context': 'https://schema.org',
				'@type': 'Review',
				name: `${artist} — ${title} Review`,
				reviewBody: description,
				datePublished: pubDate.toISOString(),
				...(updatedDate && { dateModified: updatedDate.toISOString() }),
				author: { '@type': 'Person', name: SITE_AUTHOR },
				publisher: { '@type': 'Organization', name: SITE_TITLE, url: siteUrl },
				itemReviewed: {
					'@type': 'MusicAlbum',
					name: title,
					byArtist: { '@type': 'MusicGroup', name: artist },
					...(genre && { genre }),
				},
				reviewRating: {
					'@type': 'Rating',
					ratingValue: rating,
					bestRating: 10,
					worstRating: 1,
				},
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				...(updatedDate && { dateModified: updatedDate.toISOString() }),
				author: { '@type': 'Person', name: SITE_AUTHOR },
				publisher: { '@type': 'Organization', name: SITE_TITLE, url: siteUrl },
				mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
				isPartOf: {
					'@type': 'Blog',
					name: `${SITE_TITLE} Music`,
					url: new URL('/blog', siteUrl).href,
				},
			};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${artist ? `${artist}: ${title}` : title} | ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			ogImageUrl={ogImageUrl}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			structuredData={structuredData}
		/>
		<style>
			/* Article Masthead */
			.post-hero {
				max-width: 1120px;
				margin: 0 auto 2.5rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--green);
			}

			.post-header-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.65fr);
				gap: 3rem;
				align-items: end;
			}

			.post-header-grid.single-col {
				grid-template-columns: 1fr;
				max-width: 820px;
			}

			.post-eyebrow-row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.7rem;
				margin-bottom: 1rem;
			}

			.eyebrow-sep {
				color: var(--gray-light);
			}

			.sigil-pick-badge {
				font-family: var(--font-mono);
				font-size: 0.68rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				padding: 0.2rem 0.55rem;
				border-radius: 999px;
				background: var(--green);
				color: var(--white);
			}

			.post-title {
				font-size: clamp(2.25rem, 5.2vw, 4rem);
				line-height: 0.95;
				margin: 0 0 1rem;
				color: var(--ink);
				letter-spacing: -0.04em;
			}

			.post-description {
				font-family: var(--font-sans);
				font-size: 20px;
				letter-spacing: -0.01em;
				line-height: 1.5;
				color: var(--ink-soft);
				max-width: 60ch;
				margin: 0 0 1.25rem;
			}

			.post-byline {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.65rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--gray);
			}

			.post-byline strong {
				color: var(--ink);
				font-weight: 600;
			}

			/* Review metadata grid */
			.post-meta-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25rem 1.75rem;
				padding: 1.25rem 1.35rem;
				background: var(--paper-card);
				border: 1px solid var(--rule);
				border-radius: var(--radius-md);
			}

			.meta-section {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			.meta-label {
				font-family: var(--font-mono);
				font-size: 0.66rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--green);
			}

			.meta-value {
				font-family: var(--font-display);
				font-size: 1.05rem;
				font-weight: 600;
				color: var(--ink);
				line-height: 1.25;
			}

			.meta-section.rating-section {
				grid-column: 1 / -1;
				flex-direction: row;
				align-items: baseline;
				justify-content: space-between;
				padding-bottom: 0.85rem;
				border-bottom: 1px solid var(--rule);
			}

			.meta-section.rating-section .meta-value {
				font-size: 3rem;
				font-weight: 700;
				line-height: 0.95;
				letter-spacing: -0.03em;
				color: var(--green);
			}

			.rating-denom {
				font-size: 1.2rem;
				color: var(--gray);
				font-weight: 500;
			}

			/* Hero image (only for non-NMF spreads or standalone visual header) */
			.hero-image-container {
				max-width: 1120px;
				margin: 0 auto 2.75rem;
			}

			.hero-image-container :global(img) {
				width: 100%;
				height: auto;
				border-radius: var(--radius-md);
				object-fit: cover;
				max-height: 540px;
			}

			/* NMF Magazine Spread */
			.nmf-container {
				max-width: 1040px;
				margin: 0 auto;
			}

			.nmf-intro {
				max-width: 68ch;
				margin: 0 0 2rem;
			}

			.nmf-albums {
				display: flex;
				flex-direction: column;
				gap: 0;
			}

			.nmf-album-spread {
				display: grid;
				grid-template-columns: 280px minmax(0, 1fr);
				gap: 2.5rem;
				padding: 2.75rem 0;
				border-top: 1px solid var(--rule);
				align-items: start;
			}

			.nmf-album-spread:first-child {
				border-top: none;
				padding-top: 0.5rem;
			}

			.album-sleeve-col {
				position: sticky;
				top: 5.5rem;
			}

			.album-sleeve {
				position: relative;
				aspect-ratio: 1 / 1;
				border-radius: 6px;
				overflow: hidden;
				background: var(--gray-lighter);
				border: 1px solid var(--green);
				box-shadow: 5px 5px 0 var(--green-shadow);
			}

			.album-sleeve :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.album-index {
				position: absolute;
				top: 0.65rem;
				left: 0.65rem;
				background: var(--green);
				color: #f7f6f1;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				font-weight: 500;
				padding: 0.22rem 0.5rem;
				border-radius: 4px;
			}

			.album-listen-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				margin-top: 0.85rem;
			}

			.listen-pill {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				font-weight: 500;
				padding: 0.34rem 0.65rem;
				border-radius: 999px;
				border: 1px solid var(--rule-strong);
				color: var(--ink);
				background: var(--paper-card);
				text-decoration: none;
				transition: all 0.16s ease;
			}

			.listen-pill:hover {
				border-color: var(--green);
				color: var(--green);
				background: var(--green-tint);
			}

			.album-artist-kicker {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--green);
				margin-bottom: 0.25rem;
			}

			.album-title-heading {
				font-family: var(--font-display);
				font-size: clamp(1.6rem, 2.8vw, 2.2rem);
				line-height: 1.1;
				color: var(--ink);
				margin: 0 0 0.5rem;
				letter-spacing: -0.025em;
			}

			.album-title-heading a {
				color: inherit;
			}

			.album-title-heading a:hover {
				color: var(--green);
			}

			.album-subnote {
				font-family: var(--font-sans);
				font-style: italic;
				color: var(--gray);
				margin: 0 0 1rem;
				font-size: 15px;
			}

			.album-body p {
				margin: 0 0 1.15em;
			}

			.album-body p:last-child {
				margin-bottom: 0;
			}

			.album-body :global(a) {
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			/* And More / Hot Leads box */
			.nmf-more-box {
				margin-top: 2rem;
				padding: 1.75rem 2rem;
				background: var(--paper-card);
				border: 1px solid var(--rule);
				border-top: 3px solid var(--green);
				border-radius: var(--radius-md);
			}

			.nmf-more-box h2 {
				font-size: 1.45rem;
				color: var(--ink);
				margin: 0.25rem 0 1.15rem;
			}

			.nmf-more-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.85rem 1.75rem;
			}

			.nmf-more-list li {
				margin: 0;
				padding-top: 0.65rem;
				border-top: 1px solid var(--rule);
				font-size: 0.95rem;
			}

			.nmf-more-title {
				font-family: var(--font-display);
				font-weight: 700;
				color: var(--ink);
			}

			.nmf-more-title a {
				color: var(--ink);
				text-decoration: underline;
				text-decoration-color: var(--rule-green);
				text-underline-offset: 3px;
			}

			.nmf-more-title a:hover {
				color: var(--green);
			}

			.nmf-more-note {
				display: block;
				color: var(--ink-soft);
				font-size: 0.88rem;
				margin-top: 0.2rem;
			}

			/* Coming up teaser inside NMF posts */
			.nmf-next-up {
				margin-top: 2.5rem;
				padding: 1.5rem 1.75rem;
				background: var(--green-tint);
				border: 1px solid var(--rule-green);
				border-radius: var(--radius-md);
			}

			.nmf-next-up-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 1rem;
			}

			.nmf-next-up-head h3 {
				font-size: 1.2rem;
				margin: 0.2rem 0 0;
			}

			.nmf-next-up-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}

			.next-up-item {
				background: var(--paper-card);
				border: 1px solid var(--rule);
				border-radius: var(--radius-sm);
				padding: 0.85rem 0.95rem;
			}

			.next-up-date {
				display: block;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--green);
				font-weight: 600;
				margin-bottom: 0.25rem;
			}

			.next-up-item strong {
				display: block;
				font-family: var(--font-display);
				font-size: 0.98rem;
				line-height: 1.2;
				color: var(--ink);
			}

			.next-up-item span {
				font-size: 0.84rem;
				color: var(--gray);
			}

			/* Standard article / review prose */
			.standard-article {
				max-width: 720px;
				margin: 0 auto;
			}

			.review-extras {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1rem;
				padding: 1.25rem 1.35rem;
				background: var(--paper-card);
				border: 1px solid var(--rule);
				border-radius: var(--radius-md);
				margin-bottom: 2.25rem;
			}

			.review-extra-list {
				margin: 0.35rem 0 0;
				padding: 0;
				list-style: none;
				font-size: 0.92rem;
				color: var(--ink);
			}

			.review-extra-list li {
				margin-bottom: 0.25rem;
			}

			.standard-article :global(.prose h2) {
				margin-top: 2.25rem;
				margin-bottom: 0.65rem;
				font-size: 1.65rem;
			}

			.standard-article :global(.prose h2:has(iframe)) {
				margin: 1.5rem 0;
				font-size: inherit;
			}

			.standard-article :global(.prose iframe) {
				width: 100%;
				border-radius: 12px;
				margin: 0.5rem 0 1rem;
			}

			.standard-article :global(.prose img) {
				border-radius: var(--radius-md);
				margin: 2rem auto;
				max-width: 100%;
			}

			.standard-article :global(.prose a) {
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			/* Related posts & bottom momentum */
			.post-bottom {
				max-width: 1120px;
				margin: 4.5rem auto 0;
				padding-top: 3rem;
				border-top: 1.5px solid var(--rule-strong);
			}

			.related-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 1.5rem;
				gap: 1rem;
			}

			.related-head h2 {
				font-size: 1.65rem;
				margin: 0;
				color: var(--ink);
			}

			.related-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.25rem;
				margin-bottom: 3rem;
			}

			@media (max-width: 900px) {
				.post-header-grid {
					grid-template-columns: 1fr;
					gap: 1.75rem;
				}

				.nmf-album-spread {
					grid-template-columns: 1fr;
					gap: 1.35rem;
					padding: 2rem 0;
				}

				.album-sleeve-col {
					position: static;
					max-width: 320px;
				}

				.nmf-more-list,
				.nmf-next-up-grid,
				.related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="post-hero">
				<div class:list={['post-header-grid', { 'single-col': !hasReviewMeta }]}>
					<div>
						<div class="post-eyebrow-row">
							<span class="kicker">{catLabel}</span>
							<span class="eyebrow-sep" aria-hidden="true">/</span>
							<span class="mono-meta"><FormattedDate date={pubDate} /></span>
							<span class="eyebrow-sep" aria-hidden="true">·</span>
							<span class="mono-meta">{readMin} min read</span>
							{isSigilPick && <span class="sigil-pick-badge">Sigil Pick</span>}
						</div>

						<h1 class="post-title">{title}</h1>
						{description && <p class="post-description">{description}</p>}

						<div class="post-byline">
							<span>By <strong>{SITE_AUTHOR}</strong></span>
							{updatedDate && (
								<>
									<span>·</span>
									<span>Updated <FormattedDate date={updatedDate} /></span>
								</>
							)}
						</div>
					</div>

					{hasReviewMeta && (
						<div class="post-meta-grid">
							{rating !== undefined && (
								<div class="meta-section rating-section">
									<span class="meta-label">Sigil Score</span>
									<span class="meta-value">
										{rating.toFixed(1)}
										<span class="rating-denom">/10</span>
									</span>
								</div>
							)}
							{artist && (
								<div class="meta-section">
									<span class="meta-label">Artist</span>
									<span class="meta-value">{artist}</span>
								</div>
							)}
							{genre && (
								<div class="meta-section">
									<span class="meta-label">Genre</span>
									<span class="meta-value">{genre}</span>
								</div>
							)}
							{label && (
								<div class="meta-section">
									<span class="meta-label">Label</span>
									<span class="meta-value">{label}</span>
								</div>
							)}
							{releaseDate && (
								<div class="meta-section">
									<span class="meta-label">Released</span>
									<span class="meta-value">{releaseDate}</span>
								</div>
							)}
						</div>
					)}
				</div>
			</div>

			{!useNmfSpread && heroImage && (
				<div class="hero-image-container">
					<Image src={heroImage} alt={title} width={1120} height={540} />
				</div>
			)}

			{useNmfSpread && parsedNmf ? (
				<div class="nmf-container">
					{parsedNmf.playlistEmbedUrl && (
						<SpotifyFacade embedUrl={parsedNmf.playlistEmbedUrl} title={`${title} — Spotify Playlist`} />
					)}

					{parsedNmf.introParagraphs.length > 0 && (
						<div class="prose nmf-intro">
							{parsedNmf.introParagraphs.map((p) => (
								<p set:html={renderInlineMarkdown(p)} />
							))}
						</div>
					)}

					<div class="nmf-albums">
						{parsedNmf.albums.map((entry) => (
							<article class="nmf-album-spread" id={`pick-${entry.index}`}>
								<div class="album-sleeve-col">
									<div class="album-sleeve">
										{entry.image ? (
											<Image src={entry.image} alt={`${entry.artist} — ${entry.album}`} width={560} height={560} />
										) : (
											<div style="width:100%;height:100%;background:var(--gray-lighter);" />
										)}
									</div>
									<div class="album-listen-bar">
										<ListenIcons
											spotifyUrl={entry.spotifyUrl}
											youtubeUrl={entry.youtubeUrl}
											bandcampUrl={entry.bandcampUrl}
											appleMusicUrl={entry.appleMusicUrl}
											labelPrefix={`${entry.artist} — ${entry.album}`}
										/>
									</div>
								</div>

								<div class="album-copy-col">
									<div class="album-artist-kicker">{entry.artist}</div>
									<h2 class="album-title-heading">
										{entry.directUrl ? (
											<a href={entry.directUrl} target="_blank" rel="noopener noreferrer">
												{entry.album}
											</a>
										) : (
											entry.album
										)}
									</h2>

									{entry.subtitleNote && <p class="album-subnote">{entry.subtitleNote}</p>}

									{entry.tastingNote && <TastingNote note={entry.tastingNote} tilt={true} />}

									<div class="prose album-body">
										{entry.paragraphs.map((p) => (
											<p set:html={renderInlineMarkdown(p)} />
										))}
									</div>
								</div>
							</article>
						))}
					</div>

					{parsedNmf.moreItems.length > 0 && (
						<section class="nmf-more-box">
							<span class="kicker">Bonus Crate</span>
							<h2>{parsedNmf.moreHeading ?? 'Also Worth a Spin'}</h2>
							<ul class="nmf-more-list">
								{parsedNmf.moreItems.map((item) => (
									<li>
										<span class="nmf-more-title">
											{item.url ? (
												<a href={item.url} target="_blank" rel="noopener noreferrer">
													{item.text} ↗
												</a>
											) : (
												item.text
											)}
										</span>
										{item.note && <span class="nmf-more-note">{item.note}</span>}
									</li>
								))}
							</ul>
						</section>
					)}

					{nextUpReleases.length > 0 && (
						<aside class="nmf-next-up" aria-label="Upcoming releases on Sigil's radar">
							<div class="nmf-next-up-head">
								<div>
									<span class="kicker">Release Radar</span>
									<h3>Coming Up Next on Our Radar</h3>
								</div>
								<a href="/calendar" class="mono-meta" style="color:var(--green);font-weight:600;">
									Full calendar →
								</a>
							</div>
							<div class="nmf-next-up-grid">
								{nextUpReleases.map((r) => (
									<div class="next-up-item">
										<span class="next-up-date">{formatAbbrevDate(r.releaseDate)}</span>
										<strong>{r.title}</strong>
										<span>{r.artist}</span>
									</div>
								))}
							</div>
						</aside>
					)}
				</div>
			) : (
				<article class="standard-article">
					{(essentialTracks.length > 0 || forFansOf.length > 0 || listenUrl || bandcampUrl) && (
						<div class="review-extras">
							{essentialTracks.length > 0 && (
								<div>
									<span class="meta-label">Essential Tracks</span>
									<ul class="review-extra-list">
										{essentialTracks.map((t) => (
											<li>“{t}”</li>
										))}
									</ul>
								</div>
							)}
							{forFansOf.length > 0 && (
								<div>
									<span class="meta-label">For Fans Of</span>
									<ul class="review-extra-list">
										<li>{forFansOf.join(', ')}</li>
									</ul>
								</div>
							)}
							{(listenUrl || bandcampUrl) && (
								<div>
									<span class="meta-label">Listen</span>
									<div class="album-listen-bar" style="margin-top:0.45rem;">
										{listenUrl && (
											<a href={listenUrl} target="_blank" rel="noopener noreferrer" class="listen-pill">
												Stream ↗
											</a>
										)}
										{bandcampUrl && (
											<a href={bandcampUrl} target="_blank" rel="noopener noreferrer" class="listen-pill">
												Bandcamp ↗
											</a>
										)}
									</div>
								</div>
							)}
						</div>
					)}

					<div class="prose">
						<slot />
					</div>
				</article>
			)}

			<div class="post-bottom">
				<div class="related-head">
					<h2>Keep Digging</h2>
					<a href="/blog" class="mono-meta" style="color:var(--green);font-weight:600;">
						All issues →
					</a>
				</div>
				<div class="related-grid">
					{relatedPosts.map((rel) => (
						<PostCard post={rel} variant="grid" />
					))}
				</div>

				<NewsletterStrip compact={true} />
			</div>
		</main>
		<Footer />
	</body>
</html>
